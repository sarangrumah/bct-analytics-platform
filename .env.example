# ===========================================================================
# odoo19-bct — environment template.
#
#   cp .env.example .env         # then edit by hand, OR
#   make dev-bootstrap           # generates .env with real random secrets
#
# EVERY SECRET IN THIS FILE IS THE LITERAL STRING `changeme`.
# That is deliberate and it is checked:
#   * `make scan-secret` fails if any tracked file carries a real-looking secret;
#   * odoo/render-config.py refuses to start Odoo with ODOO_ADMIN_PASSWD=changeme;
#   * postgres/init/00-init.sh refuses to initialise with a `changeme` password.
# A "plausible-looking" placeholder is worse than `changeme`, because it can be
# mistaken for a real value and shipped.
#
# .env is gitignored. .env.example is tracked. Do not swap them.
# ===========================================================================

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------
# odoo19-bct, NOT odoo19-platform: this host already runs odoo19-platform-* and
# odoo19-analytics-* stacks and they must not be touched. Every compose command
# in the Makefile is scoped with -p to this name.
COMPOSE_PROJECT_NAME=odoo19-bct

# Makes a bare `docker compose ps` / `logs` / `exec` resolve to the ODOO stack,
# so the documented commands work without repeating -f. COMPOSE_PATH_SEPARATOR
# is set explicitly because it defaults to ';' on Windows and ':' elsewhere.
#
# Only the odoo stack, deliberately. The other product stacks (insight,
# platform, agent, observability) are reached through their make targets, which
# name their files explicitly. Listing all of them here would make a bare
# `docker compose down` take down the whole platform, and this repository has
# already lost a volume once to a compose command that resolved wider than the
# person running it expected.
#
# NOTE FOR ANYONE RUNNING COMPOSE BY HAND: the files moved to compose/ on
# 2026-09-01, and compose looks for `.env` in the PROJECT DIRECTORY, which is
# the directory of the first -f file. A bare `docker compose` from the repo
# root still works (cwd is the project directory, so this file is found), but
# any invocation that passes -f explicitly must ALSO pass `--env-file .env`,
# or every ${VAR} resolves empty. The Makefile does this for you.
COMPOSE_FILE=compose/odoo.yml:compose/odoo.dev.yml
COMPOSE_PATH_SEPARATOR=:

TZ=Asia/Jakarta

# ---------------------------------------------------------------------------
# Host port block — 38xxx / 35xxx / 36xxx / 39xxx / 33xxx
#
# Bound to 127.0.0.1 ONLY, never 0.0.0.0. Ports 8069 and 5432 on this host are
# already taken by other stacks; so are 18xxx (odoo19-platform) and 2xxxx
# (odoo19-analytics). Do not move into those ranges.
#
# RESERVED for later agents — allocated here so nobody picks a bound port:
#   35433  warehouse postgres     (Data Warehouse agent)
#   38120  login-gateway          (Backend agent)
#   38200  semantic-api           (Backend agent)
#   33000  insight-portal         (Frontend agent)
# ---------------------------------------------------------------------------
ODOO_HOST_HTTP_PORT=38069
ODOO_HOST_LONGPOLLING_PORT=38072
POSTGRES_HOST_PORT=35432
REDIS_HOST_PORT=36379
GRAFANA_HOST_PORT=33001
PROMETHEUS_HOST_PORT=39090
ALERTMANAGER_HOST_PORT=39093
LOKI_HOST_PORT=33100
BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Postgres — Odoo OLTP primary
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=changeme

# The CDC / analytics identity. SELECT + REPLICATION only; it is structurally
# incapable of writing to Odoo (postgres/init/sql/20-roles.sql).
WAREHOUSE_READER_USER=warehouse_reader
WAREHOUSE_READER_PASSWORD=changeme

# postgres_exporter identity. pg_monitor only — stats and replication-slot
# state, no table data.
POSTGRES_EXPORTER_USER=metrics_exporter
POSTGRES_EXPORTER_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Odoo
# ---------------------------------------------------------------------------
ODOO_DB_HOST=postgres
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=changeme
ODOO_DB_MAXCONN=32

# The default tenant database. scripts/tenant-provision.sh creates more.
ODOO_DB_NAME=bct
# Anchored both ends. Widening this exposes other tenants at the HTTP layer.
# WIDENED 2026-09-01 from ^bct$ to admit the ATHERA admin console database.
# Contract 04 s8 makes this a reviewed edit, so it is annotated rather than
# quietly changed. It is still fully anchored at both ends and names exactly
# two databases; it is NOT the per-host ^%d$ form, which admits every database
# in the cluster and must not land before Caddy is in front of Odoo.
# PER-HOST, now that Caddy is in front. %d is the FIRST LABEL of the Host
# header, so bct.athera.localhost resolves to database `bct` and the admin
# route resolves to `athera_admin` because caddy/Caddyfile rewrites its
# upstream Host to athera_admin.athera.localhost.
#
# CONSEQUENCE, stated because it changes how you reach Odoo by hand: a request
# to http://127.0.0.1:38069 with the default Host gives %d = "127", which
# matches no database. Direct port access now needs the Host header:
#     curl -H 'Host: bct.athera.localhost' http://127.0.0.1:38069/web/login
# That is the intended posture — Caddy is the entry point — and it is why
# scripts/up-all.sh and scripts/verify.sh send that header.
# Every database this server should serve and, crucially, every database the
# queue_job runner should watch. See the comment on db_name in odoo/odoo.conf.
# ODOO_DB_NAME above stays the single default for the CLI and the scripts.
ODOO_DB_NAMES=bct,athera_admin
ODOO_DBFILTER=^%d$

# Master password (/web/database/manager). FileOnlyOption in Odoo: no CLI flag,
# no env var — odoo/render-config.py injects it into the rendered odoo.conf.
ODOO_ADMIN_PASSWD=changeme

# False hides the database manager and stops anonymous tenant enumeration.
ODOO_LIST_DB=False
# True makes Odoo trust X-Forwarded-* — required behind the reverse proxy.
ODOO_PROXY_MODE=True

ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# Sized for a dev box / single VPS. Worst case = ODOO_WORKERS * HARD limit;
# idle RSS is far lower. See docs/agents/contracts/04-platform.md for measured.
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
ODOO_LIMIT_MEMORY_SOFT=1073741824
ODOO_LIMIT_MEMORY_HARD=1342177280
ODOO_LIMIT_REQUEST=8192
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240
ODOO_LIMIT_TIME_REAL_CRON=300

ODOO_LOG_LEVEL=info

# Fernet master key for custom_core's encrypted ir.config_parameter helper.
# Required once the imported addon suite is installed: custom_storefront_api
# encrypts PII on res.partner through it, and without a key res.partner.create
# raises rather than degrading. Generated by scripts/gen-env-secrets.py.
CORETAX_SERTEL_MASTER_KEY=changeme
ODOO_WITHOUT_DEMO=True

ODOO_EMAIL_FROM=noreply@localhost
ODOO_SMTP_SERVER=localhost
ODOO_SMTP_PORT=25

# Modules installed by `make init-db`, and therefore by `make up-dev`.
#
# This shipped as `base,web` long after the five addons existed, and that is a
# definition-of-done failure, not a tidy-up: a fresh clone got no domain model,
# so `make up-analytics` died with
#     relation "pdp_field_classification" does not exist        (exit 2)
# and the only way anyone reached a working warehouse was by running
# `make install-modules MODULES=...` by hand after every cold start. QA
# reproduced that twice. Dependencies (sale_management, stock, account,
# point_of_sale, ...) are resolved by Odoo; only the leaves belong here.
#
# custom_demo_seed is in the list ON PURPOSE and it is not a contradiction of
# its own "never install in production" banner. Two separate facts:
#   * this file is the LOCAL DEV template - `cp .env.example .env`, or
#     `make dev-bootstrap`. There is no production env file in this repo, and a
#     production install set must drop custom_demo_seed.
#   * installing it is INERT. Safeguard 1 in its manifest: it generates nothing
#     at install time. Data appears only when demo.seed.generator.generate() is
#     called, which is `make seed-demo`, never a side effect of a bring-up.
#
# THE CONTROL-PLANE AND AI MODULES ARE HERE AS OF 2026-09-01, and that is the
# same class of failure as the `base,web` one above. The live `bct` database
# had 332 modules installed while this list named five, so every one of
# custom_super_admin, custom_hub_console, custom_onboarding_journey,
# custom_tenant_infra, custom_ai_bridge and custom_ai_features existed only
# because somebody ran `make install-modules` by hand. A `make down-hard`
# would have silently returned the platform to a five-module stack, and the
# ATHERA control plane and Agent would have vanished with no error anywhere.
#
# custom_storefront_api is deliberately NOT here. ADR 0002 s6: it turns stored
# res.partner fields into computed ones, which silently breaks logical
# replication of those columns - the CDC loader keeps running and the mart
# quietly loses data.
ODOO_INIT_MODULES=custom_pdp_core,custom_pdp_masking,custom_operating_unit,custom_ppob,custom_demo_seed,custom_super_admin,custom_hub_console,custom_onboarding_journey,custom_tenant_infra,custom_ai_bridge,custom_ai_features

# THE PRODUCTION SET, written out so nobody has to derive it by deleting a name
# from a long line and hoping. It is the list above minus custom_demo_seed:
#
#   ODOO_INIT_MODULES=custom_pdp_core,custom_pdp_masking,custom_operating_unit,custom_ppob,custom_super_admin,custom_hub_console,custom_onboarding_journey,custom_tenant_infra,custom_ai_bridge,custom_ai_features
#
# WHAT THAT COSTS, and it is not nothing. `make up-analytics` builds the
# bct_t2 fixture tenant by copying whatever Odoo holds AT THAT MOMENT over FDW.
# With no demo data there is nothing to copy, so bct_t2 lands empty — and four
# suites then have nothing to prove anything WITH:
#
#   test_03_reconciliation   "raw.account_move_line has no live rows; the
#                             identity is vacuous"
#   test_04_masking          the subject set must be non-empty
#   test_05_tenant_isolation `assert hidden > 0`
#   test_06_cross_tenant_403 "bct_t2 holds no rows in the marts, so every
#                             cross-tenant assertion in this suite ..."
#
# Those four FAIL rather than pass, and that is the correct behaviour: a zero
# that comes from an empty warehouse proves nothing, and a suite that reported
# green on it would be worse than one that reported red. So on a demo-free
# production stack they are not "broken tests to ignore" — they are tests that
# cannot run yet, and they become meaningful the moment the first real client
# data lands in the tenant. Run them then. Prove isolation on a staging host
# with the fixture in the meantime; do not read their red as noise.

# ---------------------------------------------------------------------------
# Dev-only login password for the Odoo USER ACCOUNTS
# ---------------------------------------------------------------------------
# Applied to `admin` and to every demo.*@contoh.invalid account custom_demo_seed
# creates, by scripts/set-dev-passwords.sh, which `make up-dev` runs on every
# bring-up and `make set-dev-passwords` runs on demand. `make dev-bootstrap`
# generates a real random value here; this file ships the placeholder, like
# every other secret.
#
# NOT the master password. ODOO_ADMIN_PASSWD above guards
# /web/database/manager; this is an ordinary login credential.
#
# WHY IT IS NOT ON render-config.py's changeme-refusal list
# --------------------------------------------------------
# That refusal is right for ODOO_ADMIN_PASSWD: a placeholder master password is
# a usable control plane - create, drop and restore any database - it exists
# whether or not anyone opted in, and there is no safe degraded mode. Failing
# closed is the only correct answer.
#
# Here, failing closed would not fail closed. Odoo boots regardless of this
# variable, so a refusal to APPLY it does not deny anyone a login; it leaves
# `admin` on Odoo's own default password, `admin`, which is strictly weaker than
# `changeme` and reachable by anyone who has ever seen an Odoo. A refusal that
# leaves the weaker credential standing is theatre, and blocking a whole
# bring-up over a dev convenience is hostile on top of being useless.
#
# So set-dev-passwords.sh applies whatever is configured, warns loudly when that
# is the placeholder, and guarantees the invariant that was actually broken:
# the running database always agrees with this file, and Odoo's default is never
# left standing. `make check-dev-passwords` asserts both halves, including the
# negative - that `admin`/`admin` is REFUSED.
#
# A wholesale `cp .env.example .env` cannot reach a running stack anyway:
# render-config.py refuses to start Odoo with ODOO_ADMIN_PASSWD=changeme and
# postgres/init/00-init.sh refuses a `changeme` POSTGRES_PASSWORD. Reaching a
# live stack with `changeme` here takes a deliberate partial edit.
BCT_DEV_USER_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_MAXMEMORY=128mb

# ---------------------------------------------------------------------------
# Observability (docker-compose.observability.yml — `make up-obs`)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=http://127.0.0.1:33001/
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
LOKI_RETENTION_PERIOD=168h
ALERTMANAGER_SMTP_FROM=alerts@localhost
ALERTMANAGER_SMTP_SMARTHOST=localhost:25

# ---------------------------------------------------------------------------
# Backup / restore (scripts/tenant-backup.sh, scripts/tenant-restore.sh)
# ---------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ===========================================================================
# RESERVED BY CONTRACT — consumed by later agents, declared here so the names
# are fixed once and nobody renames them. Platform-Infra does not read these.
# ===========================================================================

# --- Contract 01, PDP field classification ---------------------------------
# Per-tenant HMAC salt for deterministic masking at load time. One per tenant
# database; the suffix is the uppercased tenant slug. Lives in SOPS in any
# environment above dev; `changeme` here, always.
# Rotating a salt invalidates historical joins — treat it as a migration.
WAREHOUSE_MASK_SALT_DEFAULT=changeme
# Per-tenant, uppercased slug. The CDC loader REFUSES to start rather than
# hash unkeyed, so a missing salt is a loud startup failure by design.
WAREHOUSE_MASK_SALT_ACME=changeme
WAREHOUSE_MASK_SALT_BCT=changeme

# --- Contract 02, session --------------------------------------------------
# login-gateway RS256 keypair. The gateway is the ONLY holder of the private
# key; every verifier fetches the public key from JWKS and therefore never
# holds signing material. Paths are inside the login-gateway container.
LOGIN_GATEWAY_JWT_ALGORITHM=RS256
LOGIN_GATEWAY_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
LOGIN_GATEWAY_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
LOGIN_GATEWAY_JWT_KID=changeme
LOGIN_GATEWAY_JWT_ISSUER=https://login-gateway.local/
LOGIN_GATEWAY_JWT_AUDIENCE=insight-portal
# LOGIN_GATEWAY_JWKS_URL was here and is deleted, not corrected. The gateway PUBLISHES
# JWKS (login-gateway/app/keys.py:123); it never fetches one, so a variable telling the
# producer where its own keys live has no meaning. Verifiers name it after themselves --
# see SEMANTIC_API_JWKS_URL below -- so this name could not have served a future consumer
# either. It had zero consumers and carried the wrong host, which is the worst pair: the
# next person to wire it up would have inherited a 401 indistinguishable from a forged
# token. If you have it in an existing .env, gen-env-secrets.py reports it as an orphan
# and leaves it alone; delete that line by hand.
LOGIN_GATEWAY_ACCESS_TOKEN_TTL=3600
LOGIN_GATEWAY_REFRESH_COOKIE_NAME=bct_refresh
LOGIN_GATEWAY_HOST_PORT=38120

# --- Warehouse (Data Warehouse agent, port 35433 reserved above) -----------
#
# THREE ROLES, NOT ONE, and the reason is Postgres row security: a SUPERUSER
# bypasses RLS unconditionally and no policy can stop it. If dbt and the
# dashboard shared the container's POSTGRES_USER, every tenant-isolation test
# in this project would pass while proving nothing.
#
#   WAREHOUSE_ADMIN_*  the container's POSTGRES_USER. Superuser. Runs the init
#                      DDL and the backups. Nothing queries data as it.
#   WAREHOUSE_DB_*     NOSUPERUSER NOBYPASSRLS. Owns the schemas; dbt connects
#                      as it and is subject to RLS on its own tables.
#   WAREHOUSE_LOADER_* NOSUPERUSER. Backend's CDC loader. INSERT into raw.*,
#                      read/write warehouse.pipeline_state, read
#                      warehouse.column_policy. No CREATE, no access to marts.
#   WAREHOUSE_RLS_*    NOSUPERUSER NOBYPASSRLS, SELECT only. The semantic-api's
#                      identity. With app.tenant_id unset it reads zero rows.
WAREHOUSE_DB=warehouse
WAREHOUSE_ADMIN_USER=warehouse_admin
WAREHOUSE_ADMIN_PASSWORD=changeme
WAREHOUSE_DB_USER=warehouse
WAREHOUSE_DB_PASSWORD=changeme
WAREHOUSE_LOADER_USER=warehouse_loader
WAREHOUSE_LOADER_PASSWORD=changeme
WAREHOUSE_RLS_USER=warehouse_rls
WAREHOUSE_RLS_PASSWORD=changeme
WAREHOUSE_HOST_PORT=35433
# dbt threads. 4 is right for a 1 GiB warehouse container; raising it raises
# concurrent work_mem allocations, not throughput.
DBT_THREADS=4

# --- Backend (Phase 3): login-gateway key rotation, security finding T-4 --------------------
# TWO signing keys are published in JWKS from day one. A single-key JWKS cannot be rotated without
# an outage: publish first and cached verifiers reject every token; sign first and they reject every
# token until they refetch. Rotation is then: flip LOGIN_GATEWAY_JWT_KID to the NEXT kid, restart,
# wait one access-token TTL, mint a fresh standby.
LOGIN_GATEWAY_JWT_NEXT_KID=changeme
LOGIN_GATEWAY_JWT_NEXT_PRIVATE_KEY_PATH=/run/secrets/jwt-next-private.pem
LOGIN_GATEWAY_JWT_NEXT_PUBLIC_KEY_PATH=/run/secrets/jwt-next-public.pem
LOGIN_GATEWAY_REFRESH_TOKEN_TTL=1209600
# The tenant's HOSTNAME, not the service name. dbfilter is ^%d$ and applies to
# JSON-RPC too, so http://odoo:8069 resolves %d to "odoo" and every login fails
# with upstream_unavailable on a correct password. compose/odoo.yml carries the
# matching network alias.
LOGIN_GATEWAY_ODOO_URL=http://{db}.athera.localhost:8069
LOGIN_GATEWAY_ALLOWED_DATABASES=bct,acme,athera_admin
# Secure defaults to 1. Set to 0 ONLY for local http development; a refresh cookie without Secure
# travels in the clear.
LOGIN_GATEWAY_COOKIE_SECURE=0
LOGIN_GATEWAY_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_GATEWAY_RATE_LIMIT_LOCKOUT_SECONDS=900

# --- Backend (Phase 3): semantic-api --------------------------------------------------------
SEMANTIC_API_HOST_PORT=38200
# CORRECTED 2026-09-01: this is now the compose SERVICE name, not the container name.
#
# It read `odoo19-bct-login-gateway` because there was no compose service for the
# gateway anywhere in this repo -- scripts/analytics/gateway-run.sh started it with
# `docker run --name`, so the container name was the only name Docker's embedded DNS
# answered. compose/platform.yml now defines the service, so BOTH names resolve, and
# the service name is the one that survives being moved to another host: on a VPS
# split this becomes a real URL and nothing else changes.
#
# Getting this wrong is silent in the worst way: semantic-api cannot fetch JWKS, so it
# rejects every VALID token as HTTP 401 "Invalid token." -- which reads as the user's
# own login being broken rather than a misconfigured verifier.
SEMANTIC_API_JWKS_URL=http://login-gateway:8080/.well-known/jwks.json
SEMANTIC_API_JWT_ISSUER=https://login-gateway.local/
SEMANTIC_API_JWT_AUDIENCE=insight-portal
SEMANTIC_API_WAREHOUSE_HOST=warehouse-db
SEMANTIC_API_WAREHOUSE_PORT=5432
SEMANTIC_API_MAX_LIMIT=5000

# ---------------------------------------------------------------------------
# INTER-SERVICE URLs — the seam that makes a per-product VPS split possible
# ---------------------------------------------------------------------------
# Every service finds every other service through one of these, and through
# nothing else. No hostname is hard-coded in an image or a compose file.
#
# The defaults are compose SERVICE names, which resolve on the shared docker
# network. To move a product to its own VPS, change the value here to a real
# URL and change nothing else. That is the whole mechanism; there is no other
# step, and there is no service discovery to configure.
#
# Three things do NOT move with a URL change, and they are recorded here
# because each one is a trap rather than a preference:
#
#   1. cdc -> Odoo's Postgres is a REPLICATION connection, not HTTP. Splitting
#      Insight from Odoo makes it a cross-host replication link and it must
#      then carry TLS and a firewall rule. warehouse_reader already holds
#      REPLICATION; what changes is the network it crosses.
#   2. custom_super_admin reads tenant_registry.action_log_v with a direct
#      cr.execute, so the control-plane database and the admin Odoo database
#      must stay in the SAME Postgres cluster. That module cannot be split.
#   3. promtail mounts the docker socket, so it is per-host. Each VPS needs its
#      own, shipping to one central Loki.
INSIGHT_PORTAL_HOST_PORT=33000
INSIGHT_PORTAL_SEMANTIC_API_URL=http://semantic-api:8080
INSIGHT_PORTAL_LOGIN_GATEWAY_URL=http://login-gateway:8080
INSIGHT_PORTAL_JWKS_URL=http://login-gateway:8080/.well-known/jwks.json
# false only because this is loopback http in development. Behind TLS set true;
# the session cookie is httpOnly and SameSite=Strict either way.
INSIGHT_PORTAL_COOKIE_SECURE=false
INSIGHT_PORTAL_REQUEST_TIMEOUT_MS=8000
INSIGHT_PORTAL_CACHE_TTL_SECONDS=30

# ---------------------------------------------------------------------------
# ATHERA control plane (Phase 2)
# ---------------------------------------------------------------------------
# The diagram's left branch: Super Admin CMS over one Postgres, with client
# management and subscription management on top of it.
#
# ATHERA_ADMIN_DB is a SECOND Odoo database in the SAME cluster, and the
# tenant_registry schema lives inside it rather than in a master database of
# its own. That is not tidiness: custom_super_admin reads the audit view with
# a plain cr.execute, and Postgres has no cross-database SELECT, so a separate
# master DB would need a postgres_fdw that nothing sets up. It is also the one
# thing in this platform that CANNOT be moved to its own VPS.
# The base domain every ATHERA hostname hangs off. Also the suffix of the
# docker network aliases in compose/odoo.yml, so changing it changes both
# the browser route and the in-network RPC target in one place.
ATHERA_DOMAIN=athera.localhost

# How Caddy issues certificates. `internal` uses the local CA that ships in
# caddy/Caddyfile; an EMAIL ADDRESS turns on ACME (Let's Encrypt) with that
# address as the account, because `tls <email>` is Caddy's own syntax for it.
# Production is therefore this one value, not an edit to the Caddyfile.
#
# Do NOT set an email before the DNS records for every hostname in
# caddy/Caddyfile exist AND have propagated. Let's Encrypt rate-limits FAILED
# validations at 5 per hostname per hour, so a Caddy that starts too early
# spends that budget and is locked out at the moment DNS becomes correct.
ATHERA_TLS=internal

ATHERA_ADMIN_DB=athera_admin
ATHERA_ADMIN_MODULES=custom_core,custom_super_admin,custom_hub_console,custom_onboarding_journey,custom_tenant_infra,custom_athera_provisioner

# The orchestrator's own database identity. NOT a superuser: it holds CREATEDB
# so it can provision a tenant database, and nothing else. A superuser here
# would bypass every RLS policy in the platform.
ORCHESTRATOR_DB_USER=tenant_orchestrator
ORCHESTRATOR_DB_PASSWORD=changeme

# HMAC between Odoo and the orchestrator. custom_super_admin signs with
# custom.security.sign_for('ORCHESTRATOR_SHARED_SECRET', body); the orchestrator
# verifies with the same value. A mismatch is a 401 that reads like a bug in
# the Odoo module, so both sides read this one variable.
ORCHESTRATOR_SHARED_SECRET=changeme
ORCHESTRATOR_URL=http://tenant-orchestrator:8080
ORCHESTRATOR_HOST_PORT=38300

# Caddy — the single entry point (Phase 2). See caddy/Caddyfile.
# 38080/38443 chosen inside this project's reserved 38xxx band; both were
# verified free before allocation. Production uses 80/443.
CADDY_HTTP_PORT=38080
CADDY_HTTPS_PORT=38443

# Caddy's OWN bind address, and it is deliberately not ${BIND_ADDRESS}.
# BIND_ADDRESS is shared by every published port in this project — postgres
# 35432, redis 36379, warehouse-db 35433, grafana, prometheus, loki — so
# setting it to 0.0.0.0 to put the reverse proxy on the internet would put all
# of those there too, which is the opposite of what a reverse proxy is for.
#
# Empty means "follow BIND_ADDRESS", which is correct on a workstation.
# Production sets:
#     CADDY_BIND_ADDRESS=0.0.0.0
#     CADDY_HTTP_PORT=80
#     CADDY_HTTPS_PORT=443
# and leaves BIND_ADDRESS at 127.0.0.1.
CADDY_BIND_ADDRESS=

# The gateway's read-only view of the control plane — the "Active?" decision.
# This role holds SELECT on tenant_registry and EXECUTE on its two functions,
# and no grant on any tenant database. "The gateway cannot read client data" is
# therefore a property of the role, not of the gateway being careful.
#
# LOGIN_GATEWAY_REGISTRY_DSN EMPTY MEANS ENFORCEMENT IS OFF. The gateway logs
# that at WARNING on every boot and issues tokens claiming every product. Set
# it, or accept that every authenticated tenant is treated as paid up.
LOGIN_GATEWAY_REGISTRY_USER=login_gateway_registry
LOGIN_GATEWAY_REGISTRY_PASSWORD=changeme
LOGIN_GATEWAY_REGISTRY_DSN=host=postgres port=5432 dbname=athera_admin user=login_gateway_registry password=changeme
# The window in which a just-suspended tenant can still refresh a session.
LOGIN_GATEWAY_REGISTRY_CACHE_TTL=30

# The orchestrator's own two credentials, and nothing else.
#
# The DSN uses the tenant_orchestrator role: SELECT/INSERT/UPDATE on
# tenant_registry plus CREATEDB, and NOT superuser -- so it cannot bypass RLS
# anywhere in the platform. The Odoo login is what lets it enqueue a
# provisioning job; that user must be in custom_super_admin.group_super_admin,
# which the provisioner re-checks on its own side.
ORCHESTRATOR_REGISTRY_DSN=host=postgres port=5432 dbname=athera_admin user=tenant_orchestrator password=changeme
ORCHESTRATOR_ODOO_URL=http://athera_admin.athera.localhost:8069
ORCHESTRATOR_ODOO_LOGIN=admin
ORCHESTRATOR_ODOO_PASSWORD=changeme
ORCHESTRATOR_HMAC_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# ATHERA Agent (Phase 3)
# ---------------------------------------------------------------------------
# GATEWAY_SHARED_SECRET is the HMAC custom_ai_bridge already signs with
# (custom.security.sign_payload). The gateway refuses to start on a short or
# placeholder value rather than run a boundary a guess could cross.
GATEWAY_SHARED_SECRET=changeme
AI_GATEWAY_HOST_PORT=38400
AI_GATEWAY_HMAC_WINDOW_SECONDS=300
# The Odoo side reads this to find the gateway.
AI_GATEWAY_URL=http://ai-gateway:8080
#
# PROVIDER. `anthropic` is the production path and the default; the gateway
# does NOT silently fall back to a local model when a key is missing, because
# a quietly weaker answer is worse than a loud failure.
#
# Leave AI_GATEWAY_MODEL empty to take the code's default, which is
# claude-opus-5. Do not set a date-suffixed variant: the current model IDs are
# complete as they stand.
AI_GATEWAY_PROVIDER=anthropic
AI_GATEWAY_MODEL=
AI_GATEWAY_EFFORT=medium
ANTHROPIC_API_KEY=changeme
#
# The no-key path, for a laptop:
#   docker compose ... --profile local-llm up -d ollama
#   docker exec odoo19-bct-ollama ollama pull llama3.2:3b
#   AI_GATEWAY_PROVIDER=ollama AI_GATEWAY_MODEL=llama3.2:3b make up-agent
OLLAMA_BASE_URL=http://ollama:11434

# ---------------------------------------------------------------------------
# Public site (Phase 4)
# ---------------------------------------------------------------------------
# A read-only role scoped to two VIEWS. It has no grant on cms.page, so the
# site cannot serve a draft even if a query asked for one.
MARKETING_SITE_DB_USER=marketing_site_reader
MARKETING_SITE_DB_PASSWORD=changeme
MARKETING_SITE_DSN=postgresql://marketing_site_reader:changeme@postgres:5432/athera_admin
MARKETING_SITE_POOL_MAX=4
MARKETING_SITE_HOST_PORT=33002
MARKETING_SITE_LOGIN_URL=https://app.athera.localhost

# ---------------------------------------------------------------------------
# Super Admin CMS (hub-portal)
# ---------------------------------------------------------------------------
# The console edits drafts, so it reads the cms TABLES rather than the
# published-only views the public site is restricted to. It reuses the
# orchestrator's role, which already owns those writes.
HUB_PORTAL_HOST_PORT=33003
HUB_PORTAL_CMS_DSN=postgresql://tenant_orchestrator:changeme@postgres:5432/athera_admin
HUB_PORTAL_COOKIE_SECURE=false
