# Variables this service reads. Names follow contract 04 section 5: extend, never rename.
#
# NONE of these is a secret, and that is the point - the portal holds no database DSN, no signing
# key and no masking salt, so there is nothing here to leak. Authentication is delegated to
# login-gateway and every figure comes from semantic-api.
#
# NOT dot-prefixed on purpose: the root .gitignore has `.env.*` with a negation for `.env.example`
# only, so a file named `.env.portal.example` is silently untracked - the same class of failure that
# excluded three install-critical files earlier in this build. This name is outside that rule.
#
# Platform-Infra owns the root `.env.example`. These lines are published here for the diff request
# rather than added to that file unilaterally.

INSIGHT_PORTAL_HOST_PORT=33000
INSIGHT_PORTAL_SEMANTIC_API_URL=http://odoo19-bct-semantic-api:8080
INSIGHT_PORTAL_LOGIN_GATEWAY_URL=http://odoo19-bct-login-gateway:8080
INSIGHT_PORTAL_JWKS_URL=http://odoo19-bct-login-gateway:8080/.well-known/jwks.json
INSIGHT_PORTAL_JWT_ISSUER=https://login-gateway.local/
INSIGHT_PORTAL_JWT_AUDIENCE=insight-portal
INSIGHT_PORTAL_ODOO_DB=bct
INSIGHT_PORTAL_COOKIE_SECURE=false
INSIGHT_PORTAL_REQUEST_TIMEOUT_MS=8000
INSIGHT_PORTAL_CACHE_TTL_SECONDS=30
INSIGHT_PORTAL_SESSION_COOKIE_NAME=insight_portal_session
INSIGHT_PORTAL_REFRESH_COOKIE_NAME=insight_portal_refresh
INSIGHT_PORTAL_FILTERS_COOKIE_NAME=insight_portal_filters
INSIGHT_PORTAL_GATEWAY_REFRESH_COOKIE_NAME=bct_refresh
