<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_bupot">
            <t t-call="custom_accounting_reports.report_header"/>
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Tanggal</th>
                        <th>No. Bukti Potong</th>
                        <th>NPWP/NIK</th>
                        <th>Pihak Dipotong</th>
                        <th>Jenis PPh</th>
                        <th class="text-end">DPP</th>
                        <th class="text-end">Tarif (%)</th>
                        <th class="text-end">PPh Dipotong</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="lines" t-as="line">
                        <tr t-if="line.get('type') == 'note'">
                            <td colspan="8" class="text-muted fst-italic"
                                t-esc="line.get('no_bupot')"/>
                        </tr>
                        <tr t-elif="line.get('type') == 'subtotal'"
                            class="table-light fw-bold">
                            <td colspan="5" t-esc="line.get('no_bupot')"/>
                            <td class="text-end">
                                <span t-esc="line.get('dpp')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td/>
                            <td class="text-end">
                                <span t-esc="line.get('pph')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                        <tr t-elif="line.get('type') == 'grand_total'"
                            class="table-dark fw-bold">
                            <td colspan="5" t-esc="line.get('no_bupot') or 'TOTAL'"/>
                            <td class="text-end">
                                <span t-esc="line.get('dpp')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td/>
                            <td class="text-end">
                                <span t-esc="line.get('pph')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                        <tr t-else="">
                            <td t-esc="line.get('date')" t-options="{'widget': 'date'}"/>
                            <td t-esc="line.get('no_bupot')"/>
                            <td t-esc="line.get('npwp')"/>
                            <td t-esc="line.get('partner')"/>
                            <td t-esc="line.get('jenis')"/>
                            <td class="text-end">
                                <span t-esc="line.get('dpp')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end" t-esc="line.get('tarif')"/>
                            <td class="text-end">
                                <span t-esc="line.get('pph')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <t t-call="custom_accounting_reports.report_footer_signature"/>
        </template>
    </data>
</odoo>
