<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_faktur_pajak">
            <t t-call="custom_accounting_reports.report_header"/>
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Tanggal</th>
                        <th>No. Dokumen</th>
                        <th>NSFP / No. Faktur Pajak</th>
                        <th>NPWP/NIK</th>
                        <th>Lawan Transaksi</th>
                        <th class="text-end">DPP</th>
                        <th class="text-end">PPN</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="lines" t-as="line">
                        <tr t-if="line.get('type') == 'grand_total'"
                            class="table-dark fw-bold">
                            <td colspan="5" t-esc="line.get('label') or 'TOTAL'"/>
                            <td class="text-end">
                                <span t-esc="line.get('dpp')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line.get('ppn')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line.get('total')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                        <tr t-else="">
                            <td t-esc="line.get('date')" t-options="{'widget': 'date'}"/>
                            <td t-esc="line.get('invoice_no')"/>
                            <td t-esc="line.get('nsfp')"/>
                            <td t-esc="line.get('npwp')"/>
                            <td t-esc="line.get('partner')"/>
                            <td class="text-end">
                                <span t-esc="line.get('dpp')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line.get('ppn')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line.get('total')"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <t t-call="custom_accounting_reports.report_footer_signature"/>
        </template>
    </data>
</odoo>
