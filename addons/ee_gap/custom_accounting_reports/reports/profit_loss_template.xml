<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_profit_loss">
            <t t-call="custom_accounting_reports.report_header"/>
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Account</th>
                        <th class="text-end">Period</th>
                        <th class="text-end">YTD</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="lines" t-as="line">
                        <tr t-if="line.get('type') == 'section'"
                            class="table-light">
                            <td colspan="3">
                                <strong t-esc="line['label']"/>
                            </td>
                        </tr>
                        <t t-if="line.get('type') == 'section'">
                            <t t-foreach="line.get('subgroups', [])" t-as="sub">
                                <tr>
                                    <td colspan="3" class="ps-3">
                                        <strong>
                                            <span t-esc="sub['code']"/>
                                            <span t-esc="sub['label']"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr t-foreach="sub['accounts']" t-as="acc">
                                    <td class="ps-5">
                                        <span t-esc="acc['account_code']"/>
                                        <span t-esc="acc['account_name']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="acc['signed_balance']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td/>
                                </tr>
                            </t>
                            <tr t-foreach="line['accounts']" t-as="acc">
                                <td class="ps-4">
                                    <span t-esc="acc['account_code']"/>
                                    <span t-esc="acc['account_name']"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="acc.get('signed_balance', acc['balance'])"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td/>
                            </tr>
                        </t>
                        <tr t-if="line.get('type') == 'total'"
                            class="table-secondary fw-bold">
                            <td t-esc="line['label']"/>
                            <td class="text-end">
                                <span t-esc="line['signed_balance']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <span t-if="line.get('ytd') is not None"
                                      t-esc="line['ytd']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                        <tr t-if="line.get('type') == 'grand_total'"
                            class="table-dark fw-bold">
                            <td t-esc="line['label']"/>
                            <td class="text-end">
                                <span t-esc="line['signed_balance']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <span t-if="line.get('ytd') is not None"
                                      t-esc="line['ytd']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <t t-call="custom_accounting_reports.report_footer_signature"/>
        </template>
    </data>
</odoo>
