<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_advance">
            <t t-call="custom_accounting_reports.report_header"/>
            <t t-foreach="lines" t-as="line">
                <div t-if="line.get('type') == 'account'" class="mb-4">
                    <h5 class="mb-1">
                        <span t-esc="line['account_code']"/>
                        <span t-esc="line['account_name']"/>
                    </h5>
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Document No</th>
                                <th>Partner</th>
                                <th>Label</th>
                                <th>Status</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Residual</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="fw-bold">
                                <td colspan="8">Opening Balance</td>
                                <td class="text-end">
                                    <span t-esc="line['opening']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                            <tr t-foreach="line['lines']" t-as="ml">
                                <td t-esc="ml['date']"/>
                                <td t-esc="ml['doc_no']"/>
                                <td t-esc="ml['partner']"/>
                                <td t-esc="ml['label']"/>
                                <td t-esc="ml['status']"/>
                                <td class="text-end">
                                    <span t-esc="ml['debit']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="ml['credit']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="ml['residual']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="ml['running_balance']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                            <tr class="fw-bold table-secondary">
                                <td colspan="5">Total</td>
                                <td class="text-end">
                                    <span t-esc="line['total_debit']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="line['total_credit']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="line['total_residual']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="line['closing']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div t-if="line.get('type') == 'grand_total'"
                     class="alert alert-secondary fw-bold">
                    <span t-esc="line['label']"/>:
                    <span t-esc="line['closing']"
                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                </div>
            </t>
            <t t-call="custom_accounting_reports.report_footer_signature"/>
        </template>
    </data>
</odoo>
