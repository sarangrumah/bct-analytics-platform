<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Own privilege: groups that share one are rendered as a single
             pick-one dropdown on the user form, so sharing it across modules
             makes saving a user silently drop every other module's group. -->
        <record id="res_groups_privilege_accounting_reports" model="res.groups.privilege">
            <field name="name">Accounting Reports</field>
            <field name="sequence">113</field>
            <field name="category_id" ref="custom_core.module_category_custom_platform"/>
        </record>

        <record id="group_report_user" model="res.groups">
            <field name="name">Custom Reports / User</field>
            <field name="privilege_id" ref="res_groups_privilege_accounting_reports"/>
            <field name="implied_ids"
                   eval="[(4, ref('custom_core.group_custom_user'))]"/>
        </record>

        <record id="group_report_admin" model="res.groups">
            <field name="name">Custom Reports / Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_accounting_reports"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_report_user')),
                          (4, ref('custom_core.group_custom_admin'))]"/>
        </record>
    </data>
</odoo>
