<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hr_sso_keycloak" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.sso.keycloak</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="custom_core.res_config_settings_view_form_custom_core"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='custom_core']" position="inside">
                <block title="HR SSO (Keycloak)" name="hr_sso_keycloak">
                    <setting string="Auto-create users on SSO (JIT)"
                             help="Off: only existing Odoo users can sign in via Keycloak. On: unknown identities are created via OAuth signup.">
                        <field name="hr_sso_jit_create"/>
                    </setting>
                    <setting string="HC API Base URL"
                             help="Base URL (trailing slash) of the HC employee API used to enrich department/job/manager. Empty disables enrichment.">
                        <field name="hr_sso_hc_base_url" placeholder="https://hc.example.com/"/>
                    </setting>
                    <setting string="HC API Key"
                             help="Sent as X-API-Key. Stored encrypted. Leave blank to keep the existing key.">
                        <field name="hr_sso_hc_api_key" password="True" placeholder="••••••••"/>
                    </setting>
                    <setting string="Keycloak Provider"
                             help="Set the realm endpoints + client id and tick 'Allowed' on the OAuth provider, then register https://&lt;host&gt;/auth_oauth/signin in Keycloak.">
                        <span class="text-muted">Configure at Settings → Users → OAuth Providers → “Keycloak SSO”.</span>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
