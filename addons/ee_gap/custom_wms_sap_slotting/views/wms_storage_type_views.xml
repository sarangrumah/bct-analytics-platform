<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_storage_type_list" model="ir.ui.view">
        <field name="name">custom.wms.storage.type.list</field>
        <field name="model">custom.wms.storage.type</field>
        <field name="arch" type="xml">
            <list string="Storage Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="bin_type"/>
                <field name="is_high_density"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_storage_type_form" model="ir.ui.view">
        <field name="name">custom.wms.storage.type.form</field>
        <field name="model">custom.wms.storage.type</field>
        <field name="arch" type="xml">
            <form string="Storage Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code" placeholder="FO1"/>
                            <field name="name" placeholder="Footwear"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="bin_type"/>
                            <field name="is_high_density"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Search Sequence" name="search_sequence">
                            <p class="text-muted">
                                Storage types tried in order when slotting a product of this type.
                                The first entry is normally the type itself.
                            </p>
                            <field name="search_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="target_type_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_storage_type" model="ir.actions.act_window">
        <field name="name">Storage Types</field>
        <field name="res_model">custom.wms.storage.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
