<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_sap_slotting" model="ir.ui.view">
        <field name="name">product.template.form.inherit.sap.slotting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="SAP Slotting">
                    <group string="Classification">
                        <field name="wms_storage_type_id"/>
                        <field name="wms_storage_section_id"/>
                        <field name="wms_specs"/>
                        <field name="wms_gender"/>
                        <field name="wms_size"/>
                    </group>
                    <group string="Piece Dimensions">
                        <field name="wms_piece_length_mm"/>
                        <field name="wms_piece_width_mm"/>
                        <field name="wms_piece_height_mm"/>
                        <field name="wms_volume_ccm"/>
                    </group>
                    <group string="Source Master" colspan="2">
                        <field name="sap_old_material_num"/>
                        <field name="sap_brand_code"/>
                        <field name="sap_category_code"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_search_inherit_sap_slotting" model="ir.ui.view">
        <field name="name">product.template.search.inherit.sap.slotting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="sap_old_material_num"/>
                <field name="wms_storage_type_id"/>
                <field name="wms_storage_section_id"/>
            </field>
        </field>
    </record>
</odoo>
