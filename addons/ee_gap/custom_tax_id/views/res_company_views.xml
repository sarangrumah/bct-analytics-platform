<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_tax_id" model="ir.ui.view">
        <field name="name">res.company.form.tax_id</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Identitas Pemotong (Coretax)">
                    <group>
                        <field name="x_custom_nitku_suffix" placeholder="000000"/>
                        <field name="x_custom_npwp_penandatangan" placeholder="15 atau 16 digit"/>
                    </group>
                    <group>
                        <field name="x_custom_coretax_user_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
