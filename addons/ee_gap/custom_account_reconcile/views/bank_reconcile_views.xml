<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Statement lines to reconcile, grouped per journal -->
    <record id="view_custom_bank_rec_st_line_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.custom.bankrec.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false" default_order="date desc">
                <field name="date"/>
                <field name="journal_id"/>
                <field name="payment_ref"/>
                <field name="partner_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_reconciled" column_invisible="1"/>
                <button name="action_open_match_wizard" type="object" string="Match"
                        class="btn btn-primary" icon="fa-exchange"
                        invisible="is_reconciled"/>
                <button name="action_undo_reconciliation" type="object" string="Undo"
                        icon="fa-undo" invisible="not is_reconciled"
                        confirm="Undo this line's matching? Its counterparts go back to open."/>
            </list>
        </field>
    </record>

    <record id="view_custom_bank_rec_st_line_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.custom.bankrec.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="payment_ref"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <filter name="not_reconciled" string="To Reconcile"
                        domain="[('is_reconciled', '=', False)]"/>
                <filter name="reconciled" string="Reconciled"
                        domain="[('is_reconciled', '=', True)]"/>
                <separator/>
                <filter name="group_journal" string="Journal"
                        context="{'group_by': 'journal_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_custom_bank_reconciliation" model="ir.actions.act_window">
        <field name="name">Bank Reconciliation</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_custom_bank_rec_st_line_list"/>
        <field name="search_view_id" ref="view_custom_bank_rec_st_line_search"/>
        <field name="domain">[('state', '=', 'posted')]</field>
        <field name="context">{'search_default_not_reconciled': 1, 'search_default_group_journal': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to reconcile</p>
            <p>Import bank statements (Bank Import) and match each line against
               open journal items here.</p>
        </field>
    </record>

    <!-- Auto-match on selected statement lines -->
    <record id="action_st_lines_auto_match" model="ir.actions.server">
        <field name="name">Auto-match</field>
        <field name="model_id" ref="account.model_account_bank_statement_line"/>
        <field name="binding_model_id" ref="account.model_account_bank_statement_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_auto_match()</field>
    </record>

    <!-- Match wizard -->
    <record id="view_custom_bank_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">custom.bank.reconcile.wizard.form</field>
        <field name="model">custom.bank.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Match Statement Line">
                <group>
                    <group>
                        <field name="st_line_id" invisible="1"/>
                        <field name="journal_id"/>
                        <field name="date"/>
                        <field name="payment_ref"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="selected_total"/>
                        <field name="remainder"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="candidate_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="date"/>
                        <field name="move_name"/>
                        <field name="account_id"/>
                        <field name="partner_id"/>
                        <field name="name"/>
                        <field name="amount_residual"/>
                        <field name="company_currency_id" column_invisible="1"/>
                        <field name="aml_id" column_invisible="1"/>
                    </list>
                </field>
                <group>
                    <group>
                        <field name="writeoff"/>
                        <field name="writeoff_account_id" invisible="not writeoff"
                               required="writeoff"/>
                        <field name="writeoff_label" invisible="not writeoff"/>
                    </group>
                </group>
                <footer>
                    <button name="action_reconcile" type="object" string="Reconcile"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_search_more" type="object" string="Search More"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_custom_bank_reconciliation"
              action="action_custom_bank_reconciliation"
              parent="menu_custom_reconciliation"
              sequence="2"/>

</odoo>
