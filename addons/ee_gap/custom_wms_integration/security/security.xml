<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_wms_integration_manager" model="res.groups">
            <field name="name">WMS Integration / Manager</field>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="rule_wms_integration_event_company" model="ir.rule">
            <field name="name">WMS Integration Event: multi-company</field>
            <field name="model_id" ref="model_wms_integration_event"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_wms_integration_mapping_company" model="ir.rule">
            <field name="name">WMS Integration Mapping: multi-company</field>
            <field name="model_id" ref="model_wms_integration_mapping"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
