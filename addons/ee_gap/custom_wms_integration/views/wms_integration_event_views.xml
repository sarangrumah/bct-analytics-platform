<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wms_integration_event_list" model="ir.ui.view">
        <field name="name">wms.integration.event.list</field>
        <field name="model">wms.integration.event</field>
        <field name="arch" type="xml">
            <list string="WMS Outbound Events" create="false"
                  decoration-danger="state == 'failed'"
                  decoration-success="state == 'acked'"
                  decoration-muted="state == 'sent'">
                <field name="name"/>
                <field name="create_date" string="Queued"/>
                <field name="event_type"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="external_ref"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="sent_at" optional="hide"/>
                <field name="acked_at" optional="hide"/>
                <field name="last_error" class="text-danger"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wms_integration_event_form" model="ir.ui.view">
        <field name="name">wms.integration.event.form</field>
        <field name="model">wms.integration.event</field>
        <field name="arch" type="xml">
            <form string="WMS Outbound Event" create="false">
                <header>
                    <button name="action_send" type="object" string="Send Now" class="btn-primary"
                            invisible="state in ('sent', 'acked')"
                            groups="custom_wms_integration.group_wms_integration_manager"/>
                    <button name="action_retry" type="object" string="Retry"
                            invisible="state != 'failed'"
                            groups="custom_wms_integration.group_wms_integration_manager"/>
                    <button name="action_mark_acked" type="object" string="Mark Acknowledged"
                            invisible="state != 'sent'"
                            groups="custom_wms_integration.group_wms_integration_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sending,sent,acked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Event">
                            <field name="event_type" readonly="1"/>
                            <field name="external_ref" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Delivery">
                            <field name="attempts" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                            <field name="acked_at" readonly="1"/>
                            <field name="last_error" readonly="1" class="text-danger"/>
                        </group>
                    </group>
                    <group string="Source Record">
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" widget="json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_wms_integration_event_search" model="ir.ui.view">
        <field name="name">wms.integration.event.search</field>
        <field name="model">wms.integration.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="external_ref"/>
                <field name="res_id"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ('pending', 'sending'))]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="unacked" string="Sent, not acknowledged" domain="[('state', '=', 'sent')]"/>
                <group>
                    <filter name="group_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wms_integration_event" model="ir.actions.act_window">
        <field name="name">WMS Outbound Events</field>
        <field name="res_model">wms.integration.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has been pushed to the WMS host yet</p>
            <p>Every goods receipt, putaway, pick, pack, goods issue and stock adjustment
            queues here first, then a cron drains it through the adapter. A host outage
            never rolls back a warehouse transaction.</p>
        </field>
    </record>
</odoo>
