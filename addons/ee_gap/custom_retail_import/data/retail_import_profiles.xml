        <field name="name">the apparel brand — X21 Payment Report</field>
        <field name="code">retail_x21</field>
        <field name="file_type">x21</field>
        <field name="namespace">retail</field>
        <field name="file_format">xlsx</field>
        <field name="data_start_row">11</field>
