    </record>

    <!-- X29 — Inventory Adjustment. Row 1 empty, header row 2, data row 3. -->
    <record id="profile_retail_x29" model="retail.import.profile">
        <field name="name">the apparel brand — X29 Inventory Adjustment</field>
        <field name="code">retail_x29</field>
        <field name="file_type">x29</field>
        <field name="namespace">retail</field>
        <field name="file_format">xlsx</field>
        <field name="data_start_row">3</field>
