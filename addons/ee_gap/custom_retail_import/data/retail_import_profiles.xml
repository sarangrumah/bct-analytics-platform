        <field name="name">the apparel brand — X70 Tender Breakdown</field>
        <field name="code">retail_x70</field>
        <field name="file_type">x70</field>
        <field name="namespace">retail</field>
        <field name="file_format">xlsx</field>
        <field name="data_start_row">10</field>
