        <field name="column_map_json">{"store_code": 1, "sap_store_code": 3, "store_name": 4, "trans_date": 5, "total_amount": 6, "tender_amount": 7}</field>
    </record>

    <!-- X26 — Shipping Report. 8 metadata rows, header row 9, data row 10. Cols 2-3 blank (merged). -->
    <record id="profile_retail_x26" model="retail.import.profile">
        <field name="name">the apparel brand — X26 Shipping Report</field>
        <field name="code">retail_x26</field>
        <field name="file_type">x26</field>
        <field name="namespace">retail</field>
        <field name="file_format">xlsx</field>
        <field name="data_start_row">10</field>
        <field name="company_id" ref="base.main_company"/>
