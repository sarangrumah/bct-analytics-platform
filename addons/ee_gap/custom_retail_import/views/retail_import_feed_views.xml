<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retail_import_feed_list" model="ir.ui.view">
        <field name="name">retail.import.feed.list</field>
        <field name="model">retail.import.feed</field>
        <field name="arch" type="xml">
            <list string="Import Feeds" decoration-success="last_status=='ok'" decoration-danger="last_status=='error'">
                <field name="name"/>
                <field name="profile_id"/>
                <field name="source_type"/>
                <field name="host" optional="show"/>
                <field name="file_glob"/>
                <field name="last_run"/>
                <field name="last_status"/>
                <field name="files_imported"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_retail_import_feed_form" model="ir.ui.view">
        <field name="name">retail.import.feed.form</field>
        <field name="model">retail.import.feed</field>
        <field name="arch" type="xml">
            <form string="Import Feed">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"/>
                    <button name="action_poll_now" type="object" string="Poll Now" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Source">
                            <field name="name"/>
                            <field name="profile_id"/>
                            <field name="source_type"/>
                            <field name="file_glob"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="run_async" invisible="source_type == 'local'"/>
                        </group>
                        <group string="SFTP" invisible="source_type != 'sftp'">
                            <field name="host"/>
                            <field name="port"/>
                            <field name="username"/>
                            <field name="auth_type"/>
                            <field name="password_param" invisible="auth_type != 'password'"/>
                            <field name="private_key_path" invisible="auth_type != 'key'"/>
                            <field name="remote_dir"/>
                        </group>
                        <group string="Local directory (FTPS drop)" invisible="source_type != 'local'">
                            <field name="local_dir" placeholder="/mnt/data_retail/data"/>
                            <field name="archive_dir" placeholder="/mnt/data_retail/archive"/>
                        </group>
                    </group>
                    <group string="Last run">
                        <field name="last_run"/>
                        <field name="last_status"/>
                        <field name="files_imported"/>
                        <field name="last_message"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_retail_import_feed" model="ir.actions.act_window">
        <field name="name">Import Feeds</field>
        <field name="res_model">retail.import.feed</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
