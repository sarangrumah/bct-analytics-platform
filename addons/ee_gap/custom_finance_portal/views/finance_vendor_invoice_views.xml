<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finance_vendor_invoice_list" model="ir.ui.view">
        <field name="name">finance.vendor.invoice.list</field>
        <field name="model">finance.vendor.invoice</field>
        <field name="arch" type="xml">
            <list string="Vendor Invoice (Non-Trade)"
                  decoration-info="state=='submitted'"
                  decoration-success="state in ('approved','posted','paid')"
                  decoration-danger="state=='rejected'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="invoice_subtype"/>
                <field name="vendor_id"/>
                <field name="invoice_number"/>
                <field name="po_number" optional="show"/>
                <field name="gr_number" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="sap_payment_status" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_finance_vendor_invoice_form" model="ir.ui.view">
        <field name="name">finance.vendor.invoice.form</field>
        <field name="model">finance.vendor.invoice</field>
        <field name="arch" type="xml">
            <form string="Vendor Invoice">
                <header>
                    <button name="action_submit_for_approval" type="object"
                            string="Submit for Approval" class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="custom_finance_portal.group_finance_user,custom_finance_portal.group_finance_vendor"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="custom_finance_portal.group_finance_officer"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"
                            groups="custom_finance_portal.group_finance_officer"/>
                    <button name="action_open_approval_request" type="object" string="View Approval"
                            invisible="not x_custom_approval_request_id"
                            groups="custom_finance_portal.group_finance_user"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('submitted','rejected','cancelled')"
                            groups="custom_finance_portal.group_finance_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('paid','posted','cancelled')"
                            groups="custom_finance_portal.group_finance_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,pushed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="invoice_subtype" readonly="state != 'draft'"/>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="invoice_type_id" readonly="state != 'draft'"/>
                            <field name="routine_type_id" readonly="state != 'draft'"/>
                            <field name="division_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="invoice_number" readonly="state != 'draft'"/>
                            <field name="invoice_date" readonly="state != 'draft'"/>
                            <field name="po_number" readonly="state != 'draft'"
                                   invisible="invoice_subtype == 'non_po_non_trade'"/>
                            <field name="gr_number" readonly="state != 'draft'"
                                   invisible="invoice_subtype == 'non_po_non_trade'"/>
                            <field name="amount_untaxed"/>
                            <field name="tax_amount" readonly="state != 'draft'"/>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="item_id"/>
                                    <field name="account_code"/>
                                    <field name="cost_center_code"/>
                                    <field name="quantity"/>
                                    <field name="unit_amount"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="SAP / Approval" name="sap">
                            <group>
                                <group string="Approval">
                                    <field name="x_custom_approval_state" widget="badge" readonly="1"/>
                                </group>
                                <group string="SAP Mirror (auto-MIRO)">
                                    <field name="sap_sync_state"/>
                                    <field name="sap_document_no" string="MIRO / SAP Doc"/>
                                    <field name="sap_payment_plan_date"/>
                                    <field name="sap_payment_status"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <field name="description" placeholder="Description..."/>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_finance_vendor_invoice_search" model="ir.ui.view">
        <field name="name">finance.vendor.invoice.search</field>
        <field name="model">finance.vendor.invoice</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="invoice_number"/>
                <field name="po_number"/>
                <separator/>
                <filter name="f_po" string="PO Non-Trade" domain="[('invoice_subtype','=','po_non_trade')]"/>
                <filter name="f_nonpo" string="Non-PO Non-Trade" domain="[('invoice_subtype','=','non_po_non_trade')]"/>
                <separator/>
                <filter name="f_submitted" string="On Process" domain="[('state','=','submitted')]"/>
                <filter name="f_paid" string="Paid" domain="[('state','=','paid')]"/>
                <group>
                    <filter name="g_subtype" string="Class" context="{'group_by':'invoice_subtype'}"/>
                    <filter name="g_vendor" string="Vendor" context="{'group_by':'vendor_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_finance_vendor_invoice" model="ir.actions.act_window">
        <field name="name">Vendor Invoice (Non-Trade)</field>
        <field name="res_model">finance.vendor.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_finance_vendor_invoice_search"/>
    </record>

</odoo>
