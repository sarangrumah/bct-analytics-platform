<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finance_travel_settlement_list" model="ir.ui.view">
        <field name="name">finance.travel.settlement.list</field>
        <field name="model">finance.travel.settlement</field>
        <field name="arch" type="xml">
            <list string="Perjalanan Dinas (HRIS)"
                  decoration-success="settlement_state=='settled'"
                  decoration-warning="settlement_state=='partial'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="destination"/>
                <field name="travel_from"/>
                <field name="travel_to"/>
                <field name="estimated_amount"/>
                <field name="realized_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="hris_state" widget="badge"/>
                <field name="settlement_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_finance_travel_settlement_form" model="ir.ui.view">
        <field name="name">finance.travel.settlement.form</field>
        <field name="model">finance.travel.settlement</field>
        <field name="arch" type="xml">
            <form string="Perjalanan Dinas Settlement">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="requester_id" readonly="1"/>
                            <field name="division_id" readonly="1"/>
                            <field name="destination" readonly="1"/>
                            <field name="purpose" readonly="1"/>
                        </group>
                        <group>
                            <field name="x_sap_external_id" readonly="1"/>
                            <field name="travel_from" readonly="1"/>
                            <field name="travel_to" readonly="1"/>
                            <field name="hris_state" readonly="1"/>
                            <field name="estimated_amount" readonly="1"/>
                            <field name="realized_amount" readonly="1"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Settlement (portal money documents)">
                        <field name="cash_advance_id"/>
                        <field name="reimbursement_id"/>
                        <field name="settlement_state" widget="badge"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_finance_travel_settlement" model="ir.actions.act_window">
        <field name="name">Perjalanan Dinas (HRIS)</field>
        <field name="res_model">finance.travel.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
