<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_finance_cash_advance" model="ir.sequence">
            <field name="name">Cash Advance</field>
            <field name="code">finance.cash.advance</field>
            <field name="prefix">CA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_finance_cash_advance_realization" model="ir.sequence">
            <field name="name">Cash Advance Realization</field>
            <field name="code">finance.cash.advance.realization</field>
            <field name="prefix">CAR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_finance_reimbursement" model="ir.sequence">
            <field name="name">Reimbursement</field>
            <field name="code">finance.reimbursement</field>
            <field name="prefix">RB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_finance_vendor_invoice" model="ir.sequence">
            <field name="name">Vendor Invoice (Non-Trade)</field>
            <field name="code">finance.vendor.invoice</field>
            <field name="prefix">VINV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
