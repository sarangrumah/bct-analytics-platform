<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oauth_provider_form_code_flow" model="ir.ui.view">
        <field name="name">auth.oauth.provider.form.code.flow</field>
        <field name="model">auth.oauth.provider</field>
        <field name="inherit_id" ref="auth_oauth.view_oauth_provider_form"/>
        <field name="arch" type="xml">
            <field name="client_id" position="after">
                <field name="flow"/>
                <field name="token_endpoint"
                       required="flow == 'authorization_code'"
                       invisible="flow != 'authorization_code'"
                       placeholder="https://keycloak.example.com/realms/&lt;realm&gt;/protocol/openid-connect/token"/>
                <field name="client_secret"
                       password="True"
                       invisible="flow != 'authorization_code'"
                       placeholder="Leave blank to keep the stored secret"/>
            </field>
        </field>
    </record>
</odoo>
