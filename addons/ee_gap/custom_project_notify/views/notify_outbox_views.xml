<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_notify_outbox_list" model="ir.ui.view">
        <field name="name">custom.project.notify.outbox.list</field>
        <field name="model">custom.project.notify.outbox</field>
        <field name="arch" type="xml">
            <list string="Outbox" decoration-danger="state == 'failed'"
                  decoration-muted="state == 'sent'">
                <field name="create_date" string="Queued"/>
                <field name="event"/>
                <field name="res_model"/>
                <field name="res_label"/>
                <field name="vertical_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-danger="state == 'failed'"/>
                <field name="attempt"/>
                <field name="next_retry_at"/>
                <field name="error"/>
                <button name="action_retry" type="object" string="Retry" icon="fa-refresh"
                        invisible="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="view_notify_outbox_form" model="ir.ui.view">
        <field name="name">custom.project.notify.outbox.form</field>
        <field name="model">custom.project.notify.outbox</field>
        <field name="arch" type="xml">
            <form string="Outbox entry">
                <header>
                    <button name="action_retry" type="object" string="Retry now"
                            class="btn-primary" invisible="state == 'sent'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="res_label"/>
                            <field name="vertical_id"/>
                        </group>
                        <group>
                            <field name="attempt"/>
                            <field name="next_retry_at"/>
                            <field name="sent_at"/>
                            <field name="error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload_json" widget="text"/>
                        </page>
                        <page string="Deliveries" name="deliveries">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="channel"/>
                                    <field name="transport"/>
                                    <field name="recipient_name"/>
                                    <field name="recipient_phone_masked"/>
                                    <field name="success"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_notify_outbox" model="ir.actions.act_window">
        <field name="name">Notification Outbox</field>
        <field name="res_model">custom.project.notify.outbox</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
