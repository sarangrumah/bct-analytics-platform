<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retail_mdm_category_map_list" model="ir.ui.view">
        <field name="name">retail.mdm.category.map.list</field>
        <field name="model">retail.mdm.category.map</field>
        <field name="arch" type="xml">
            <list string="MDM Category Crosswalk" editable="bottom">
                <field name="gender"/>
                <field name="category1"/>
                <field name="category2"/>
                <field name="categ_id"/>
                <field name="x101_category"/>
                <field name="x101_class"/>
                <field name="x101_subclass"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_retail_mdm_category_map_search" model="ir.ui.view">
        <field name="name">retail.mdm.category.map.search</field>
        <field name="model">retail.mdm.category.map</field>
        <field name="arch" type="xml">
            <search>
                <field name="category1"/>
                <field name="category2"/>
                <field name="gender"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category1" string="Category 1"
                            context="{'group_by': 'category1'}"/>
                    <filter name="group_gender" string="Gender" context="{'group_by': 'gender'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_retail_mdm_category_map" model="ir.actions.act_window">
        <field name="name">MDM Category Crosswalk</field>
        <field name="res_model">retail.mdm.category.map</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_retail_mdm_category_map_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No crosswalk entries yet.</p>
            <p>
                MDM sends a two-level <code>category1</code>/<code>category2</code> pair; X101 uses a
                gender-prefixed three-level tree, and the product category drives the revenue and COGS
                accounts. Map each pair here — either pin a product category directly, or give the
                X101 CATEGORY/CLASS/SUBCLASS triple to reuse the tree the file import already built.
            </p>
            <p>
                Unmapped pairs still create their product, so sales can post, but the template is
                flagged <b>MDM Category Unmapped</b> for review.
            </p>
        </field>
    </record>
</odoo>
