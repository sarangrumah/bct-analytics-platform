<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_wms_qc_inspector" model="res.groups">
            <field name="name">Inbound QC / Inspector</field>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_wms_qc_manager" model="res.groups">
            <field name="name">Inbound QC / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_wms_qc_inspector')), (4, ref('stock.group_stock_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
