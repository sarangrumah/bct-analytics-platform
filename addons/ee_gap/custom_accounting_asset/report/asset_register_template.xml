<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Self-contained wrapper: no web.html_container / web.internal_layout, so
         wkhtmltopdf never makes the external asset (report.url) callback that stalls
         on this platform. <main> is required by ir_actions_report._prepare_html.
         Reuses the shared letterhead (custom_accounting_reports.report_header),
         which renders the per-company logo + address from the `company` context var. -->
    <template id="report_asset_register">
        <html>
            <head>
                <meta charset="utf-8"/>
                <style>
                    @page { margin: 12mm; }
                    * { box-sizing: border-box; }
                    body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; margin: 0; padding: 0; }
                    table.data { width: 100%; border-collapse: collapse; font-size: 9px; }
                    table.data th, table.data td { border: 1px solid #b0b0b0; padding: 3px 5px; }
                    table.data thead th { background-color: #f3f3f3; text-align: left; }
                    table.data td.num, table.data th.num { text-align: right; }
                    table.data tr.total td { font-weight: bold; background-color: #e8e8e8; }
                </style>
            </head>
            <body>
                <main>
                    <div class="page">
                        <t t-call="custom_accounting_reports.report_header"/>
                        <table class="data">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>Code</th>
                                    <th>Asset Name</th>
                                    <th>Acq. Date</th>
                                    <th class="num">Acquisition Value</th>
                                    <th class="num">Accum. Opening</th>
                                    <th class="num">YTD</th>
                                    <th class="num">Accum. End</th>
                                    <th class="num">Book Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lines" t-as="line"
                                    t-att-class="'total' if line.get('type') == 'grand_total' else ''">
                                    <td t-esc="line.get('no')"/>
                                    <td t-esc="line.get('code')"/>
                                    <td t-esc="line.get('name')"/>
                                    <td t-esc="line.get('acq_date')"/>
                                    <td class="num">
                                        <span t-esc="line.get('acq_value')"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="num">
                                        <span t-esc="line.get('opening')"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="num">
                                        <span t-esc="line.get('ytd')"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="num">
                                        <span t-esc="line.get('accum_end')"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="num">
                                        <span t-esc="line.get('book')"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </main>
            </body>
        </html>
    </template>
</odoo>
