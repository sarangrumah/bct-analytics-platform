<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_revaluation_wizard_form" model="ir.ui.view">
        <field name="name">custom.fixed.asset.revaluation.wizard.form</field>
        <field name="model">custom.fixed.asset.revaluation.wizard</field>
        <field name="arch" type="xml">
            <form string="Revalue Asset">
                <group>
                    <field name="asset_id" readonly="1"/>
                    <field name="net_book_value"/>
                    <field name="revaluation_date"/>
                    <field name="new_value"/>
                    <field name="revaluation_amount"/>
                    <field name="new_remaining_life"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <group string="Posting (IAS 16)">
                    <field name="journal_id"/>
                    <field name="surplus_account_id"/>
                    <field name="income_account_id"
                           invisible="revaluation_amount &lt; 0"/>
                    <field name="loss_account_id"
                           invisible="revaluation_amount &gt;= 0"/>
                </group>
                <group>
                    <field name="note" nolabel="1" placeholder="Revaluation notes..."/>
                </group>
                <footer>
                    <button name="action_revalue" type="object" string="Revalue"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
