<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_post_wizard_form" model="ir.ui.view">
        <field name="name">custom.fixed.asset.post.wizard.form</field>
        <field name="model">custom.fixed.asset.post.wizard</field>
        <field name="arch" type="xml">
            <form string="Post Due Depreciation">
                <group>
                    <field name="cutoff_date"/>
                    <field name="group_id"/>
                    <field name="location_id"/>
                    <field name="company_ids" widget="many2many_tags"
                           groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_post" type="object"
                            string="Post Depreciation" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_post_wizard" model="ir.actions.act_window">
        <field name="name">Post Depreciation</field>
        <field name="res_model">custom.fixed.asset.post.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
