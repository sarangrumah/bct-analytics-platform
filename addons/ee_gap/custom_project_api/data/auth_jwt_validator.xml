<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- The secret is a placeholder on purpose: it is replaced at deploy time from
             VAS_PMO_JWT_SECRET. A committed secret is not a secret. -->
        <record id="jwt_validator_pmo" model="auth.jwt.validator">
            <field name="name">pmo</field>
            <field name="signature_type">secret</field>
            <field name="secret_algorithm">HS256</field>
            <field name="secret_key">change-me-at-deploy-time</field>
            <field name="audience">pmo</field>
            <field name="issuer">custom_project_api</field>
            <field name="user_id_strategy">pmo_login</field>
            <field name="partner_id_strategy">email</field>
            <field name="partner_id_required" eval="False"/>
        </record>

        <record id="param_access_ttl" model="ir.config_parameter">
            <field name="key">custom_project_api.access_ttl</field>
            <field name="value">900</field>
        </record>

        <record id="cron_token_purge" model="ir.cron">
            <field name="name">VAS PMO: purge expired refresh tokens</field>
            <field name="model_id" ref="model_custom_pmo_token"/>
            <field name="state">code</field>
            <field name="code">model.cron_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
