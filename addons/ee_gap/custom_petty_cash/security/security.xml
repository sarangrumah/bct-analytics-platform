<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_petty_cash" model="res.groups.privilege">
            <field name="name">Petty Cash</field>
            <field name="sequence">130</field>
        </record>

        <!-- Employee: raise requests + realizations for themselves. Granted to
             every internal user (see base.group_user implied below), so no
             self-implication of base.group_user here (that would cycle). -->
        <record id="group_petty_cash_user" model="res.groups">
            <field name="name">Petty Cash / User</field>
            <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        </record>

        <!-- Finance: review, approve, disburse, post, settle across all. -->
        <record id="group_petty_cash_finance" model="res.groups">
            <field name="name">Petty Cash / Finance</field>
            <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
            <field name="implied_ids" eval="[(4, ref('group_petty_cash_user')), (4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
    <!-- Every internal user is made a 'Petty Cash / User' by the module's
         post_init_hook (ORM write on base.group_user.implied_ids), which is
         what reliably propagates the group to all existing + future users. -->
</odoo>
