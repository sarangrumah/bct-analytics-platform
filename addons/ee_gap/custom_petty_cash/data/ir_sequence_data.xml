<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_petty_cash_request" model="ir.sequence">
            <field name="name">Petty Cash Request</field>
            <field name="code">petty.cash.request</field>
            <field name="prefix">PC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_petty_cash_realization" model="ir.sequence">
            <field name="name">Petty Cash Realization</field>
            <field name="code">petty.cash.realization</field>
            <field name="prefix">PCR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
