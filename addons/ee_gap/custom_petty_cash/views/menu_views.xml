<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_petty_cash_config" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="context">{'module': 'account', 'bin_size': False}</field>
        </record>

        <menuitem id="menu_petty_cash_root" name="Petty Cash"
                  web_icon="account,static/description/icon.png"
                  sequence="55"
                  groups="custom_petty_cash.group_petty_cash_user"/>

        <menuitem id="menu_petty_cash_requests" name="Requests"
                  parent="menu_petty_cash_root"
                  action="action_petty_cash_request" sequence="10"/>

        <menuitem id="menu_petty_cash_realizations" name="Realizations"
                  parent="menu_petty_cash_root"
                  action="action_petty_cash_realization" sequence="20"/>

        <menuitem id="menu_petty_cash_reporting" name="Reporting"
                  parent="menu_petty_cash_root" sequence="30"
                  groups="custom_petty_cash.group_petty_cash_finance"/>
        <menuitem id="menu_petty_cash_outstanding" name="Outstanding"
                  parent="menu_petty_cash_reporting"
                  action="action_petty_cash_outstanding" sequence="10"/>
        <menuitem id="menu_petty_cash_aging" name="Aging"
                  parent="menu_petty_cash_reporting"
                  action="action_petty_cash_aging" sequence="20"/>

        <menuitem id="menu_petty_cash_config_root" name="Configuration"
                  parent="menu_petty_cash_root" sequence="90"
                  groups="custom_petty_cash.group_petty_cash_finance"/>
        <menuitem id="menu_petty_cash_settings" name="Settings"
                  parent="menu_petty_cash_config_root"
                  action="action_petty_cash_config" sequence="10"/>
    </data>
</odoo>
