<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
             Route the two petty-cash report codes through the shared
             financial-report dispatcher (PDF). Screen + XLSX are wired
             purely through REPORT_MODEL_MAP; only PDF needs a template.
             ============================================================ -->
        <template id="report_dispatch_petty_cash" inherit_id="custom_accounting_reports.report_dispatch">
            <xpath expr="//t[@t-else='']" position="before">
                <t t-elif="report_code == 'petty_cash_outstanding'">
                    <t t-call="custom_petty_cash.report_petty_cash_outstanding"/>
                </t>
                <t t-elif="report_code == 'petty_cash_aging'">
                    <t t-call="custom_petty_cash.report_petty_cash_aging"/>
                </t>
            </xpath>
        </template>

        <!-- Outstanding — flat table over the report engine's `lines`. -->
        <template id="report_petty_cash_outstanding">
            <t t-call="custom_accounting_reports.report_header"/>
            <table class="table table-sm" style="width:100%;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Reference</th>
                        <th>Operating Unit</th>
                        <th>Deadline</th>
                        <th class="text-end">Disbursed</th>
                        <th class="text-end">Realized</th>
                        <th class="text-end">Outstanding</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="lines" t-as="line"
                        t-att-style="line.get('type') in ('subtotal','grand_total') and 'font-weight:bold;background:#f2f2f2;' or ''">
                        <td t-esc="line.get('employee_name')"/>
                        <td t-esc="line.get('reference')"/>
                        <td t-esc="line.get('ou_name')"/>
                        <td t-esc="line.get('deadline')"/>
                        <td class="text-end">
                            <span t-esc="line.get('disbursed')" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="line.get('realized')" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="line.get('outstanding')" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        </td>
                        <td t-esc="line.get('status')"/>
                    </tr>
                </tbody>
            </table>
            <t t-call="custom_accounting_reports.report_footer_signature"/>
        </template>

        <!-- Aging — employee rows across age buckets. -->
        <template id="report_petty_cash_aging">
            <t t-call="custom_accounting_reports.report_header"/>
            <table class="table table-sm" style="width:100%;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th class="text-end">Not Due</th>
                        <th class="text-end">0-30</th>
                        <th class="text-end">31-60</th>
                        <th class="text-end">61-90</th>
                        <th class="text-end">91-180</th>
                        <th class="text-end">181-365</th>
                        <th class="text-end">365+</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="lines" t-as="line"
                        t-att-style="line.get('type') == 'grand_total' and 'font-weight:bold;background:#f2f2f2;' or ''">
                        <td t-esc="line.get('employee_name')"/>
                        <td class="text-end"><span t-esc="line.get('not_due')" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                        <td class="text-end"><span t-esc="line.get('d_0_30')" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                        <td class="text-end"><span t-esc="line.get('d_31_60')" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                        <td class="text-end"><span t-esc="line.get('d_61_90')" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                        <td class="text-end"><span t-esc="line.get('d_91_180')" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                        <td class="text-end"><span t-esc="line.get('d_181_365')" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                        <td class="text-end"><span t-esc="line.get('d_over_365')" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                        <td class="text-end"><span t-esc="line.get('total')" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                    </tr>
                </tbody>
            </table>
            <t t-call="custom_accounting_reports.report_footer_signature"/>
        </template>

        <!-- ============================================================
             Disbursement voucher (Bukti Pencairan Petty Cash).
             Self-contained wrapper with <main> (no web.html_container) so
             wkhtmltopdf never makes the stalling asset callback.
             ============================================================ -->
        <record id="action_report_disbursement_voucher" model="ir.actions.report">
            <field name="name">Petty Cash Voucher</field>
            <field name="model">petty.cash.request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_petty_cash.report_disbursement_voucher</field>
            <field name="report_file">custom_petty_cash.report_disbursement_voucher</field>
            <field name="binding_model_id" ref="model_petty_cash_request"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Petty Cash Voucher - %s' % (object.name)</field>
        </record>

        <template id="report_disbursement_voucher">
            <html>
                <head>
                    <meta charset="utf-8"/>
                    <style>
                        @page { margin: 14mm; }
                        body { font-family: Arial, Helvetica, sans-serif; font-size: 12px; }
                        table { border-collapse: collapse; width: 100%; }
                        td, th { padding: 4px 6px; }
                        .box td { border: 1px solid #999; }
                        .title { font-size: 20px; font-weight: bold; margin-bottom: 10px; }
                        .lbl { color: #555; width: 30%; }
                    </style>
                </head>
                <body>
                    <main>
                        <t t-foreach="docs" t-as="doc">
                            <div class="page" style="page-break-after: always;">
                                <div class="title">Bukti Pencairan Petty Cash</div>
                                <table class="box">
                                    <tr><td class="lbl">Reference</td><td t-esc="doc.name"/></tr>
                                    <tr><td class="lbl">Employee</td><td t-esc="doc.employee_id.name"/></tr>
                                    <tr><td class="lbl">Operating Unit</td><td t-esc="doc.l10n_ou_analytic_id.name or ''"/></tr>
                                    <tr><td class="lbl">Request Date</td><td t-esc="doc.request_date"/></tr>
                                    <tr><td class="lbl">Realization Deadline</td><td t-esc="doc.realization_deadline or ''"/></tr>
                                    <tr><td class="lbl">Purpose</td><td t-esc="doc.purpose or ''"/></tr>
                                    <tr>
                                        <td class="lbl">Amount</td>
                                        <td>
                                            <span t-esc="doc.amount_requested"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                                <div t-if="doc.line_ids" style="margin-top:12px;">
                                    <strong>Estimate Breakdown</strong>
                                    <table class="box" style="margin-top:4px;">
                                        <thead>
                                            <tr><th>Description</th><th>Account</th><th class="text-end">Amount</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="doc.line_ids" t-as="l">
                                                <td t-esc="l.name"/>
                                                <td t-esc="l.account_id.display_name or ''"/>
                                                <td class="text-end">
                                                    <span t-esc="l.amount"
                                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <table style="margin-top:48px;">
                                    <tr>
                                        <td style="text-align:center;">Requested by<br/><br/><br/>__________________</td>
                                        <td style="text-align:center;">Approved by<br/><br/><br/>__________________</td>
                                        <td style="text-align:center;">Received by<br/><br/><br/>__________________</td>
                                    </tr>
                                </table>
                            </div>
                        </t>
                    </main>
                </body>
            </html>
        </template>
    </data>
</odoo>
