<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wms_label_wizard_form" model="ir.ui.view">
        <field name="name">custom.wms.label.wizard.form</field>
        <field name="model">custom.wms.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Labels">
                <group>
                    <group>
                        <field name="label_kind"/>
                        <field name="barcode_kind"/>
                    </group>
                    <group>
                        <field name="qty_source"/>
                        <field name="picking_id"
                               required="qty_source == 'picking_qty'"/>
                        <field name="qty_per_product"
                               invisible="qty_source != 'manual'"/>
                    </group>
                </group>
                <group string="Products">
                    <field name="product_ids" nolabel="1" widget="many2many_tags"
                           required="qty_source == 'manual'"/>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Menu entry (see views/menu_views.xml). -->
    <record id="action_wms_label_wizard" model="ir.actions.act_window">
        <field name="name">Print Labels</field>
        <field name="res_model">custom.wms.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Contextual "Print Labels" action on product variants... -->
    <record id="action_wms_label_wizard_product" model="ir.actions.act_window">
        <field name="name">Print Labels</field>
        <field name="res_model">custom.wms.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- ...on product templates... -->
    <record id="action_wms_label_wizard_product_template" model="ir.actions.act_window">
        <field name="name">Print Labels</field>
        <field name="res_model">custom.wms.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- ...and on transfers (defaults to one label per unit shipped). -->
    <record id="action_wms_label_wizard_picking" model="ir.actions.act_window">
        <field name="name">Print Labels</field>
        <field name="res_model">custom.wms.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
