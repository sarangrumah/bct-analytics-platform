<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_history_wizard_form" model="ir.ui.view">
        <field name="name">custom.report.repair.history.wizard.form</field>
        <field name="model">custom.report.repair.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Repair Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button string="View" name="action_view" type="object" class="btn-primary"/>
                    <button string="Export Excel" name="action_export_xlsx" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_repair_history_wizard" model="ir.actions.act_window">
        <field name="name">Repair Report</field>
        <field name="res_model">custom.report.repair.history.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
