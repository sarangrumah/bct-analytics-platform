<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Own privilege: groups that share one are rendered as a single
             pick-one dropdown on the user form, so sharing it across modules
             makes saving a user silently drop every other module's group. -->
        <record id="res_groups_privilege_pmo" model="res.groups.privilege">
            <field name="name">VAS PMO</field>
            <field name="sequence">115</field>
            <field name="category_id" ref="custom_core.module_category_custom_platform"/>
        </record>

        <!-- Odoo 19 replaced ir.module.category + res.groups.category_id with
             res.groups.privilege + privilege_id. The privilege above carries the
             custom_core category, so VAS PMO still shows up next to the other
             custom apps on the user form, but as its own selector. -->

        <!-- Read-only member of the team. -->
        <record id="group_pmo_user" model="res.groups">
            <field name="name">VAS PMO / Member</field>
            <field name="privilege_id" ref="res_groups_privilege_pmo"/>
            <field name="comment">Read-only view of every project, task and change request.</field>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <!-- Business Analyst: owns analysis and the weekly report. -->
        <record id="group_pmo_ba" model="res.groups">
            <field name="name">VAS PMO / Business Analyst</field>
            <field name="privilege_id" ref="res_groups_privilege_pmo"/>
            <field name="comment">Writes impact analysis and the weekly progress report.</field>
            <field name="implied_ids" eval="[(4, ref('custom_project_portfolio.group_pmo_user'))]"/>
        </record>

        <!-- Product Owner: approves change requests, owns project health. -->
        <record id="group_pmo_po" model="res.groups">
            <field name="name">VAS PMO / Product Owner</field>
            <field name="privilege_id" ref="res_groups_privilege_pmo"/>
            <field name="comment">Approves change requests and owns project health.</field>
            <field name="implied_ids" eval="[(4, ref('custom_project_portfolio.group_pmo_ba'))]"/>
        </record>

        <!-- PO Lead: sees everything, no configuration rights. -->
        <record id="group_pmo_lead" model="res.groups">
            <field name="name">VAS PMO / PO Lead</field>
            <field name="privilege_id" ref="res_groups_privilege_pmo"/>
            <field name="comment">Portfolio-wide oversight, delivery log and outbox.</field>
            <field name="implied_ids" eval="[(4, ref('custom_project_portfolio.group_pmo_po'))]"/>
        </record>

        <!-- Admin: master data (verticals, stages, notification rules, integrations). -->
        <record id="group_pmo_admin" model="res.groups">
            <field name="name">VAS PMO / Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_pmo"/>
            <field name="comment">Master data: verticals, stages and their SLA clock, notification rules.</field>
            <field name="implied_ids" eval="[
                (4, ref('custom_project_portfolio.group_pmo_lead')),
                (4, ref('project.group_project_manager')),
            ]"/>
        </record>

        <!-- Brand-side PIC: verifies delivered work for their own vertical only.
             Deliberately does NOT imply group_pmo_user — this account belongs to the
             brand, not to the VAS team. -->
        <record id="group_pmo_vertical_pic" model="res.groups">
            <field name="name">VAS PMO / Brand PIC</field>
            <field name="privilege_id" ref="res_groups_privilege_pmo"/>
            <field name="comment">Brand-side contact. Sees only their own vertical's work, to verify it.</field>
        </record>

    </data>
</odoo>
