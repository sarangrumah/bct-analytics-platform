<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- The seven-stage set. `custom_sla_clock` is the field that makes team metrics
             honest: Hold pauses the clock, Waiting User Verification books the time to
             the brand instead of the team. -->

        <record id="stage_backlog" model="project.task.type">
            <field name="name">Backlog</field>
            <field name="custom_code">backlog</field>
            <field name="sequence">10</field>
            <field name="custom_applies_to">both</field>
            <field name="custom_sla_clock">running</field>
        </record>

        <record id="stage_analysis" model="project.task.type">
            <field name="name">Analisis (BA)</field>
            <field name="custom_code">analysis</field>
            <field name="sequence">20</field>
            <field name="custom_applies_to">both</field>
            <field name="custom_sla_clock">running</field>
        </record>

        <record id="stage_dev" model="project.task.type">
            <field name="name">Development</field>
            <field name="custom_code">dev</field>
            <field name="sequence">30</field>
            <field name="custom_applies_to">both</field>
            <field name="custom_sla_clock">running</field>
        </record>

        <record id="stage_uat" model="project.task.type">
            <field name="name">UAT</field>
            <field name="custom_code">uat</field>
            <field name="sequence">40</field>
            <field name="custom_applies_to">both</field>
            <field name="custom_sla_clock">running</field>
        </record>

        <record id="stage_waiting_user" model="project.task.type">
            <field name="name">Waiting User Verification</field>
            <field name="custom_code">waiting_user</field>
            <field name="sequence">50</field>
            <field name="custom_applies_to">both</field>
            <field name="custom_sla_clock">user_side</field>
            <field name="custom_is_waiting_user" eval="True"/>
            <field name="custom_auto_close_days">5</field>
        </record>

        <record id="stage_done" model="project.task.type">
            <field name="name">Selesai</field>
            <field name="custom_code">done</field>
            <field name="sequence">60</field>
            <field name="custom_applies_to">both</field>
            <field name="custom_sla_clock">stopped</field>
            <field name="custom_is_closed_stage" eval="True"/>
            <field name="fold" eval="True"/>
        </record>

        <!-- Hold is a side stage, not a step. It sits last in sequence so it renders at
             the end of the board, and it demands a reason. -->
        <record id="stage_hold" model="project.task.type">
            <field name="name">Hold</field>
            <field name="custom_code">hold</field>
            <field name="sequence">90</field>
            <field name="custom_applies_to">both</field>
            <field name="custom_sla_clock">paused</field>
            <field name="custom_is_hold" eval="True"/>
            <field name="custom_require_reason" eval="True"/>
            <field name="fold" eval="True"/>
        </record>

        <!-- Allowed transitions, written after every stage exists. Hold is reachable
             from anywhere, which is why it appears in each list. -->

        <record id="stage_backlog" model="project.task.type">
            <field name="custom_next_stage_ids" eval="[Command.set([
                ref('stage_analysis'), ref('stage_hold')])]"/>
        </record>

        <record id="stage_analysis" model="project.task.type">
            <field name="custom_next_stage_ids" eval="[Command.set([
                ref('stage_dev'), ref('stage_backlog'), ref('stage_hold')])]"/>
        </record>

        <record id="stage_dev" model="project.task.type">
            <field name="custom_next_stage_ids" eval="[Command.set([
                ref('stage_uat'), ref('stage_analysis'), ref('stage_hold')])]"/>
        </record>

        <record id="stage_uat" model="project.task.type">
            <field name="custom_next_stage_ids" eval="[Command.set([
                ref('stage_waiting_user'), ref('stage_dev'), ref('stage_hold')])]"/>
        </record>

        <record id="stage_waiting_user" model="project.task.type">
            <field name="custom_next_stage_ids" eval="[Command.set([
                ref('stage_done'), ref('stage_uat'), ref('stage_hold')])]"/>
        </record>

        <!-- Coming off hold may land anywhere upstream; the task remembers where it was. -->
        <record id="stage_hold" model="project.task.type">
            <field name="custom_next_stage_ids" eval="[Command.set([
                ref('stage_backlog'), ref('stage_analysis'), ref('stage_dev'),
                ref('stage_uat'), ref('stage_waiting_user')])]"/>
        </record>

    </data>
</odoo>
