<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Brand seed: generic retail segments, not one customer's brand list.
             `legal_entity` is left unset; each tenant fills in its own. -->

        <record id="vertical_retail" model="custom.project.vertical">
            <field name="name">the apparel brand</field>
            <field name="code">RETAIL</field>
            <field name="brand_group">retail_fashion</field>
            <field name="sequence">10</field>
            <field name="color">4</field>
        </record>

        <record id="vertical_womenswear" model="custom.project.vertical">
            <field name="name">Womenswear</field>
            <field name="code">WOMENSWEAR</field>
            <field name="brand_group">retail_fashion</field>
            <field name="sequence">20</field>
            <field name="color">9</field>
        </record>

        <record id="vertical_pos" model="custom.project.vertical">
            <field name="name">POS</field>
            <field name="code">POS</field>
            <field name="brand_group">digital</field>
            <field name="sequence">30</field>
            <field name="color">1</field>
        </record>

        <record id="vertical_tenant" model="custom.project.vertical">
            <field name="name">the tenant</field>
            <field name="code">TENANT</field>
            <field name="brand_group">digital</field>
            <field name="sequence">40</field>
            <field name="color">6</field>
        </record>

        <record id="vertical_mobile" model="custom.project.vertical">
            <field name="name">Mobile Retail</field>
            <field name="code">MOBILE</field>
            <field name="brand_group">retail_gadget</field>
            <field name="sequence">50</field>
            <field name="color">2</field>
            <field name="active" eval="False"/>
        </record>

        <record id="vertical_lifestyle" model="custom.project.vertical">
            <field name="name">Lifestyle Retail</field>
            <field name="code">LIFESTYLE</field>
            <field name="brand_group">retail_gadget</field>
            <field name="sequence">60</field>
            <field name="color">3</field>
            <field name="active" eval="False"/>
        </record>

        <record id="vertical_warehouse" model="custom.project.vertical">
            <field name="name">Warehouse &amp; Distribution</field>
            <field name="code">WAREHOUSE</field>
            <field name="brand_group">supply_chain</field>
            <field name="sequence">70</field>
            <field name="color">7</field>
        </record>

        <record id="vertical_corp" model="custom.project.vertical">
            <field name="name">Example Group — Shared Services</field>
            <field name="code">CORP</field>
            <field name="brand_group">shared</field>
            <field name="sequence">80</field>
            <field name="color">8</field>
        </record>

    </data>
</odoo>
