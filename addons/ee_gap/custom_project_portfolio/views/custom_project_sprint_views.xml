<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sprint_list" model="ir.ui.view">
        <field name="name">custom.project.sprint.list</field>
        <field name="model">custom.project.sprint</field>
        <field name="arch" type="xml">
            <list string="Weekly Sprints">
                <field name="week_code"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'"/>
                <field name="committed_points" string="Committed"/>
                <field name="done_points" string="Done"/>
                <field name="carry_over_count" string="Carry-over"/>
                <field name="capacity_points" string="Capacity"/>
            </list>
        </field>
    </record>

    <record id="view_sprint_form" model="ir.ui.view">
        <field name="name">custom.project.sprint.form</field>
        <field name="model">custom.project.sprint</field>
        <field name="arch" type="xml">
            <form string="Sprint">
                <sheet>
                    <div class="oe_title">
                        <label for="week_code"/>
                        <h1><field name="week_code" placeholder="2026-W31"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state"/>
                            <field name="capacity_points"/>
                        </group>
                        <group>
                            <field name="committed_points"/>
                            <field name="done_points"/>
                            <field name="carry_over_count"/>
                        </group>
                    </group>
                    <group string="Sprint goal">
                        <field name="goal" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="custom_vertical_id"/>
                                    <field name="stage_id"/>
                                    <field name="custom_story_points"/>
                                    <field name="custom_carried_over"/>
                                </list>
                            </field>
                        </page>
                        <page string="Weekly reports" name="weekly">
                            <field name="weekly_ids" readonly="1">
                                <list>
                                    <field name="vertical_id"/>
                                    <field name="project_id"/>
                                    <field name="author_id"/>
                                    <field name="done_count"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sprint" model="ir.actions.act_window">
        <field name="name">Weekly Sprints</field>
        <field name="res_model">custom.project.sprint</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
