<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_portfolio_list" model="ir.ui.view">
        <field name="name">custom.project.portfolio.list</field>
        <field name="model">custom.project.portfolio</field>
        <field name="arch" type="xml">
            <list string="Portfolios">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="health" widget="badge"
                       decoration-success="health == 'on_track'"
                       decoration-warning="health == 'at_risk'"
                       decoration-danger="health == 'blocked'"/>
            </list>
        </field>
    </record>

    <record id="view_portfolio_form" model="ir.ui.view">
        <field name="name">custom.project.portfolio.form</field>
        <field name="model">custom.project.portfolio</field>
        <field name="arch" type="xml">
            <form string="Portfolio">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="owner_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="health"/>
                        </group>
                    </group>
                    <group string="Objective">
                        <field name="objective" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Projects" name="projects">
                            <field name="project_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="custom_vertical_id"/>
                                    <field name="custom_health"/>
                                    <field name="custom_progress" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_portfolio" model="ir.actions.act_window">
        <field name="name">Portfolios</field>
        <field name="res_model">custom.project.portfolio</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
