<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_change_request" model="ir.sequence">
            <field name="name">VAS Change Request</field>
            <field name="code">custom.change.request</field>
            <field name="prefix">CR-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <!-- Intake that nobody looked at inside the response SLA is the one failure the
             brand always notices. Checked hourly. -->
        <record id="cron_intake_sla" model="ir.cron">
            <field name="name">VAS PMO: change-request intake SLA</field>
            <field name="model_id" ref="model_custom_change_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_intake_sla()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
