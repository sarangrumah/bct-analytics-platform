<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Headless platform posture.
      ==========================
      On this multi-tenant platform the customer-facing frontend (ecommerce or
      company profiling) is always an external Next.js app driven through THIS
      module's JSON API. Odoo serves only the back-office (admin + sales). Odoo's
      own website FRONTEND and visual EDITOR are therefore unused.

      Why this matters (the bug it removes):
      The website editor's `website.website_builder_assets` bundle is lazy-loaded
      by the `website.website_preview` client action (the "Website" app) inside an
      iframe that does NOT carry the tenant session cookie. With the platform
      dbfilter `^.*$` (several tenants, no single default DB) a cookie-less
      `/web/assets/...` request cannot be resolved to a tenant DB -> 404 -> an
      uncaught `AssetsLoadingError` pops up in the back-office. The bundle only
      ever loads through the "Website" app, so hiding that app stops it for good.

      Scope: this ONLY hides the Website app (the Odoo editor/frontend). The whole
      `website_sale` BACK-END (the draft `sale.order` cart this module reuses,
      products, orders, customers) stays available under the Sales app and is
      untouched. Reversible: set active=True on the menu to bring the app back.

      NOTE: `ir.actions.client` has no group field in Odoo 19, so the action itself
      can't be group-gated; hiding the app menu is the supported lever.
    -->
    <record id="website.menu_website_configuration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
