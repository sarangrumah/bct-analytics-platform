<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_proof_list" model="ir.ui.view">
        <field name="name">custom.storefront.payment.proof.list</field>
        <field name="model">custom.storefront.payment.proof</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'verified'"
                  decoration-danger="state == 'rejected'"
                  decoration-info="state == 'submitted'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="bank_reference"/>
                <field name="paid_date"/>
                <field name="transaction_state"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'verified'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_payment_proof_form" model="ir.ui.view">
        <field name="name">custom.storefront.payment.proof.form</field>
        <field name="model">custom.storefront.payment.proof</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" type="object" string="Verify &amp; Settle"
                            class="btn-primary" invisible="state == 'verified'"
                            confirm="Mark this transfer as received and settle the payment transaction?"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state == 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,verified,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Payment">
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="transaction_id"/>
                            <field name="provider_id"/>
                            <field name="transaction_state"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                        </group>
                        <group string="Transfer Details">
                            <field name="sender_name"/>
                            <field name="bank_reference"/>
                            <field name="paid_date"/>
                            <field name="proof_filename" invisible="not proof_filename"/>
                        </group>
                    </group>
                    <group string="Customer Note">
                        <field name="note" nolabel="1"/>
                    </group>
                    <group string="Proof Image">
                        <field name="proof_image" widget="image" nolabel="1"/>
                    </group>
                    <group string="Review" invisible="state == 'submitted'">
                        <field name="reviewed_by" readonly="1"/>
                        <field name="reviewed_on" readonly="1"/>
                        <field name="review_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payment_proof_search" model="ir.ui.view">
        <field name="name">custom.storefront.payment.proof.search</field>
        <field name="model">custom.storefront.payment.proof</field>
        <field name="arch" type="xml">
            <search string="Transfer Proofs">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="bank_reference"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="verified" string="Verified" domain="[('state', '=', 'verified')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_payment_proof" model="ir.actions.act_window">
        <field name="name">Transfer Proofs</field>
        <field name="res_model">custom.storefront.payment.proof</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No manual transfer proofs yet.</p>
            <p>When a storefront customer pays by bank transfer and uploads proof,
               their submission appears here for verification.</p>
        </field>
    </record>

    <menuitem id="menu_storefront_payment_proof" name="Transfer Proofs"
              parent="menu_storefront_root" action="action_payment_proof" sequence="30"/>

</odoo>
