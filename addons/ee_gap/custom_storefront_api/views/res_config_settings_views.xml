<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_storefront_payments" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.storefront.payments</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="custom_core.res_config_settings_view_form_custom_core"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='custom_core']" position="inside">
                <block title="Storefront Payments" name="storefront_payments">
                    <setting string="Enable Storefront Payments"
                             help="Master switch for the headless storefront checkout. When off, the storefront shows no payment methods.">
                        <field name="custom_storefront_payments_enabled"/>
                    </setting>
                    <setting string="Default Payment Method"
                             help="Method pre-selected at checkout. Manual Bank Transfer works without credentials; redirect gateways need keys on the provider form.">
                        <field name="custom_storefront_default_provider"/>
                    </setting>
                    <setting string="Published Providers"
                             help="Toggle a provider's 'Published' flag on its form to show or hide it at storefront checkout.">
                        <field name="custom_storefront_published_summary" nolabel="1" readonly="1"/>
                        <div class="mt-2">
                            <button name="action_open_payment_providers" type="object"
                                    string="Configure Payment Providers" class="btn-link" icon="fa-credit-card"/>
                            <button name="action_open_transfer_proofs" type="object"
                                    string="Transfer Proofs" class="btn-link" icon="fa-inbox"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
