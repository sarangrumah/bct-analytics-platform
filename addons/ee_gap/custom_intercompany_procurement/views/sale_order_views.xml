<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_asset_loan" model="ir.ui.view">
        <field name="name">sale.order.form.asset.loan</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_loan_orders" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="loan_order_count == 0">
                    <field name="loan_order_count" widget="statinfo" string="Asset Loans"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_preflight_loan" type="object"
                        string="Create Pre-Flight Loan"
                        invisible="not is_asset_loan or state != 'sale'"/>
            </xpath>
        </field>
    </record>
</odoo>
