<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esb_outbox_list" model="ir.ui.view">
        <field name="name">custom.esb.outbox.list</field>
        <field name="model">custom.esb.outbox</field>
        <field name="arch" type="xml">
            <list string="ESB Outbound Documents" create="false"
                  decoration-danger="state == 'failed'"
                  decoration-success="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="create_date" string="Created"/>
                <field name="doc_type"/>
                <field name="esb_doc_num"/>
                <field name="state"/>
                <field name="adopted" string="Adopted" optional="show"/>
                <field name="attempt_count" string="Attempts"/>
                <field name="sent_at" optional="hide"/>
                <field name="last_error" class="text-danger"/>
            </list>
        </field>
    </record>

    <record id="view_esb_outbox_form" model="ir.ui.view">
        <field name="name">custom.esb.outbox.form</field>
        <field name="model">custom.esb.outbox</field>
        <field name="arch" type="xml">
            <form string="ESB Outbound Document" create="false">
                <header>
                    <button name="action_push_now" type="object" string="Push Now" class="btn-primary"
                            invisible="state not in ('draft', 'queued', 'failed')"/>
                    <button name="action_queue" type="object" string="Re-queue"
                            invisible="state != 'failed'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'failed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'queued', 'failed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,sent,confirmed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Adopted" bg_color="text-bg-info" invisible="not adopted"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="doc_type" readonly="1"/>
                            <field name="esb_doc_num" readonly="1"/>
                            <field name="esb_status_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group string="Delivery">
                            <field name="idempotency_key" readonly="1"/>
                            <field name="attempt_count" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                            <field name="adopted" readonly="1"/>
                            <field name="last_error" readonly="1" class="text-danger"/>
                        </group>
                    </group>
                    <group string="Source Record">
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" widget="json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_esb_outbox_search" model="ir.ui.view">
        <field name="name">custom.esb.outbox.search</field>
        <field name="model">custom.esb.outbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="esb_doc_num"/>
                <field name="idempotency_key"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ('draft', 'queued'))]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="adopted" string="Adopted (deduplicated)" domain="[('adopted', '=', True)]"/>
                <group>
                    <filter name="group_type" string="Document Type" context="{'group_by': 'doc_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_esb_outbox" model="ir.actions.act_window">
        <field name="name">ESB Outbound Documents</field>
        <field name="res_model">custom.esb.outbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has been sent to ESB yet</p>
            <p>Every document Odoo creates in ESB passes through here. Because ESB accepts no
            idempotency key, each row checks whether its document already exists before posting,
            so a retry adopts rather than duplicates.</p>
        </field>
    </record>
</odoo>
