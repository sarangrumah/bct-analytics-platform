<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_return_report_list" model="ir.ui.view">
        <field name="name">custom.wms.purchase.return.report.list</field>
        <field name="model">custom.wms.purchase.return.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <header>
                    <button name="action_export_xlsx" type="object" string="Export XLSX (with barcode)"
                            class="btn-primary"/>
                </header>
                <field name="date"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="default_code" optional="show"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="lot_ids_display" optional="hide"/>
                <field name="quantity" sum="Total Qty"/>
                <field name="unit_cost" optional="hide"/>
                <field name="value" sum="Total Value"/>
                <field name="origin" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_return_report_pivot" model="ir.ui.view">
        <field name="name">custom.wms.purchase.return.report.pivot</field>
        <field name="model">custom.wms.purchase.return.report</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_purchase_return_report_search" model="ir.ui.view">
        <field name="name">custom.wms.purchase.return.report.search</field>
        <field name="model">custom.wms.purchase.return.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="default_code"/>
                <field name="reference"/>
                <filter name="filter_linked" string="Linked to Receipt" domain="[('is_return_of_receipt', '=', True)]"/>
                <filter name="filter_date" date="date"/>
                <group>
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Product (SKU)" context="{'group_by': 'product_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_return_report" model="ir.actions.act_window">
        <field name="name">Purchase Return Report</field>
        <field name="res_model">custom.wms.purchase.return.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_purchase_return_report_search"/>
        <field name="context">{'search_default_group_supplier': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No purchase returns yet</p>
            <p>Done moves whose destination is a supplier location appear here.
               Group by supplier or SKU, and use the list export for XLSX.</p>
        </field>
    </record>

</odoo>
