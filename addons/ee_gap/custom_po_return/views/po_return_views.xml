<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_po_return_form" model="ir.ui.view">
        <field name="name">custom.po.return.form</field>
        <field name="model">custom.po.return</field>
        <field name="arch" type="xml">
            <form string="PO Return">
                <header>
                    <button name="action_compute_allocation" type="object"
                            string="Compute Allocation" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_validate" type="object"
                            string="Validate" class="btn-primary"
                            invisible="state != 'allocated'"
                            confirm="This will create the return pickings (stock decrease) and draft vendor credit notes. Continue?"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('allocated', 'cancel')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state not in ('draft', 'allocated')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,allocated,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_return_pickings" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="return_picking_count == 0">
                            <field name="return_picking_count" widget="statinfo"
                                   string="Return Pickings"/>
                        </button>
                        <button name="action_view_credit_notes" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="credit_note_count == 0">
                            <field name="credit_note_count" widget="statinfo"
                                   string="Credit Notes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"
                                   context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty_to_return"/>
                                    <field name="uom_id"/>
                                    <field name="allocated_qty"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount_subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Allocations" name="allocations">
                            <field name="allocation_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="order_id"/>
                                    <field name="picking_id"/>
                                    <field name="source_bill_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="return_picking_id"/>
                                    <field name="credit_note_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_custom_po_return_list" model="ir.ui.view">
        <field name="name">custom.po.return.list</field>
        <field name="model">custom.po.return</field>
        <field name="arch" type="xml">
            <list string="PO Returns">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'allocated'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_custom_po_return_search" model="ir.ui.view">
        <field name="name">custom.po.return.search</field>
        <field name="model">custom.po.return</field>
        <field name="arch" type="xml">
            <search string="PO Returns">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Allocated" name="allocated" domain="[('state', '=', 'allocated')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Vendor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_custom_po_return" model="ir.actions.act_window">
        <field name="name">PO Returns</field>
        <field name="res_model">custom.po.return</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_custom_po_return_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a PO Return
            </p>
            <p>
                Enter the vendor, products and total quantities to return.
                The system allocates the return across previous purchase
                orders (FIFO) at the original PO prices, creates the return
                pickings and draft vendor credit notes.
            </p>
        </field>
    </record>

    <menuitem id="menu_custom_po_return"
              name="PO Returns"
              parent="purchase.menu_procurement_management"
              action="action_custom_po_return"
              sequence="30"/>
</odoo>
