<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_po_return" model="ir.ui.view">
        <field name="name">purchase.order.form.po.return</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_po_returns" type="object"
                        class="oe_stat_button" icon="fa-undo"
                        invisible="x_custom_po_return_count == 0">
                    <field name="x_custom_po_return_count" widget="statinfo"
                           string="PO Returns"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
