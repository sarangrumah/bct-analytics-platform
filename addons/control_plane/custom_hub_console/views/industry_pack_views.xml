<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_industry_pack_list" model="ir.ui.view">
        <field name="name">custom.hub.industry.pack.list</field>
        <field name="model">custom.hub.industry.pack</field>
        <field name="arch" type="xml">
            <list string="Industry Packs">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="vertical"/>
                <field name="module_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_industry_pack_form" model="ir.ui.view">
        <field name="name">custom.hub.industry.pack.form</field>
        <field name="model">custom.hub.industry.pack</field>
        <field name="arch" type="xml">
            <form string="Industry Pack">
                <header>
                    <button name="action_open_deploy_pack_wizard" type="object"
                            string="Deploy Pack" class="btn-primary"
                            groups="custom_hub_console.group_hub_admin"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Retail / POS"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="retail"/>
                            <field name="vertical"/>
                            <field name="icon"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="module_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Modules">
                        <field name="module_ids" nolabel="1"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_industry_pack_search" model="ir.ui.view">
        <field name="name">custom.hub.industry.pack.search</field>
        <field name="model">custom.hub.industry.pack</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="vertical"/>
                <field name="module_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_industry_pack" model="ir.actions.act_window">
        <field name="name">Industry Packs</field>
        <field name="res_model">custom.hub.industry.pack</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_industry_pack_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first industry pack</p>
            <p>Bundle curated modules per business vertical so you can deploy them to a tenant in one action.</p>
        </field>
    </record>
</odoo>
