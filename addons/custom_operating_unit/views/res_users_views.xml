<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_operating_unit" model="ir.ui.view">
        <field name="name">res.users.form.operating.unit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="operating_units" string="Operating Units">
                    <group>
                        <field name="default_operating_unit_id"/>
                    </group>
                    <field name="allowed_operating_unit_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <p class="text-muted">
                        Leaving this empty is fail-closed: the user then sees only documents that
                        carry no Operating Unit. This list is also what the login gateway reads to
                        build the <code>allowed_ou</code> claim.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
