<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ppob_biller_list" model="ir.ui.view">
        <field name="name">ppob.biller.list</field>
        <field name="model">ppob.biller</field>
        <field name="arch" type="xml">
            <list string="Billers" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="sla_target_seconds"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ppob_biller_form" model="ir.ui.view">
        <field name="name">ppob.biller.form</field>
        <field name="model">ppob.biller</field>
        <field name="arch" type="xml">
            <form string="Biller">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="PLN Prabayar"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="PLN-PRE"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="sla_target_seconds"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ppob_biller_search" model="ir.ui.view">
        <field name="name">ppob.biller.search</field>
        <field name="model">ppob.biller</field>
        <field name="arch" type="xml">
            <search string="Billers">
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_category" string="Category" domain="[]"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ppob_biller" model="ir.actions.act_window">
        <field name="name">Billers</field>
        <field name="res_model">ppob.biller</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
