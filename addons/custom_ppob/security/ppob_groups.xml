<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_ppob" model="ir.module.category">
            <field name="name">PPOB</field>
            <field name="description">Payment Point Online Bank - bill payments and top-ups.</field>
            <field name="sequence">85</field>
        </record>

        <record id="res_groups_privilege_ppob" model="res.groups.privilege">
            <field name="name">PPOB</field>
            <field name="category_id" ref="module_category_ppob"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_ppob_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_ppob"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Records and settles PPOB transactions.</field>
        </record>

        <record id="group_ppob_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_ppob"/>
            <field name="implied_ids" eval="[(4, ref('group_ppob_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Manages billers and may reverse a settled transaction.</field>
        </record>

    </data>
</odoo>
