<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ppob_va_bank_connection_list" model="ir.ui.view">
        <field name="name">custom.ppob.va.bank.connection.list</field>
        <field name="model">custom.ppob.va.bank.connection</field>
        <field name="arch" type="xml">
            <list string="Bank H2H Connections">
                <field name="name"/>
                <field name="bank_code"/>
                <field name="status" widget="badge"/>
                <field name="credential_ref"/>
            </list>
        </field>
    </record>

    <record id="view_ppob_va_bank_connection_form" model="ir.ui.view">
        <field name="name">custom.ppob.va.bank.connection.form</field>
        <field name="model">custom.ppob.va.bank.connection</field>
        <field name="arch" type="xml">
            <form string="VA H2H Connection">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bank_code"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="credential_ref"/>
                            <field name="endpoint_inbound"/>
                            <field name="ip_whitelist" placeholder="203.0.113.4, 198.51.100.0/24"/>
                            <field name="max_clock_skew_s"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ppob_va_bank_connection" model="ir.actions.act_window">
        <field name="name">VA Bank Connections</field>
        <field name="res_model">custom.ppob.va.bank.connection</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
