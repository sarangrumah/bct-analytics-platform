<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ppob_va_topup_list" model="ir.ui.view">
        <field name="name">custom.ppob.va.topup.list</field>
        <field name="model">custom.ppob.va.topup</field>
        <field name="arch" type="xml">
            <list string="VA Topups" decoration-success="state=='credited'" decoration-warning="state=='received'" decoration-danger="state=='rejected'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="va_account_id"/>
                <field name="mitra_id"/>
                <field name="amount" sum="Sum"/>
                <field name="bank_ref"/>
                <field name="source"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ppob_va_topup_form" model="ir.ui.view">
        <field name="name">custom.ppob.va.topup.form</field>
        <field name="model">custom.ppob.va.topup</field>
        <field name="arch" type="xml">
            <form string="VA Topup">
                <header>
                    <button name="action_credit_wallet" type="object"
                            string="Credit Wallet" class="btn-primary"
                            invisible="state not in ['received','settled'] or wallet_move_id"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-secondary"
                            invisible="state in ['credited','rejected']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="va_account_id"/>
                            <field name="mitra_id"/>
                            <field name="wallet_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="bank_ref"/>
                            <field name="source"/>
                            <field name="statement_line_id"/>
                            <field name="wallet_move_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ppob_va_topup_pivot" model="ir.ui.view">
        <field name="name">custom.ppob.va.topup.pivot</field>
        <field name="model">custom.ppob.va.topup</field>
        <field name="arch" type="xml">
            <pivot string="VA Topups">
                <field name="va_account_id" type="row"/>
                <field name="create_date" interval="month" type="row"/>
                <field name="state" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ppob_va_topup_graph" model="ir.ui.view">
        <field name="name">custom.ppob.va.topup.graph</field>
        <field name="model">custom.ppob.va.topup</field>
        <field name="arch" type="xml">
            <graph string="VA Topups" type="bar">
                <field name="create_date" interval="day"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_ppob_va_topup" model="ir.actions.act_window">
        <field name="name">VA Topups</field>
        <field name="res_model">custom.ppob.va.topup</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

</odoo>
