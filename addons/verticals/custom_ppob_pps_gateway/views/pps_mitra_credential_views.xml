<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pps_mitra_credential_list" model="ir.ui.view">
        <field name="name">custom.ppob.pps.mitra.credential.list</field>
        <field name="model">custom.ppob.pps.mitra.credential</field>
        <field name="arch" type="xml">
            <list string="PPS Mitra Credentials">
                <field name="pps_user"/>
                <field name="mitra_id"/>
                <field name="credential_ref"/>
                <field name="callback_url"/>
                <field name="ip_whitelist"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_pps_mitra_credential_form" model="ir.ui.view">
        <field name="name">custom.ppob.pps.mitra.credential.form</field>
        <field name="model">custom.ppob.pps.mitra.credential</field>
        <field name="arch" type="xml">
            <form string="PPS Mitra Credential">
                <sheet>
                    <group>
                        <group>
                            <field name="pps_user"/>
                            <field name="mitra_id"/>
                            <field name="credential_ref"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="callback_url"/>
                            <field name="ip_whitelist"/>
                            <field name="max_clock_skew_s"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pps_mitra_credential" model="ir.actions.act_window">
        <field name="name">PPS Mitra Credentials</field>
        <field name="res_model">custom.ppob.pps.mitra.credential</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
