<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_form_ppob_rollup" model="ir.ui.view">
        <field name="name">sale.order.form.custom.ppob.rollup</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="PPOB Rollup" invisible="not x_custom_ppob_is_rollup">
                    <field name="x_custom_ppob_is_rollup" readonly="1"/>
                    <field name="x_custom_ppob_rollup_date" readonly="1"/>
                    <field name="x_custom_ppob_transaction_count" readonly="1"/>
                    <button name="action_open_rolled_up" type="object"
                            string="View Rolled-up Transactions"
                            icon="fa-list"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_ppob_rollup_so" model="ir.actions.act_window">
        <field name="name">PPOB Rollup Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_custom_ppob_is_rollup','=',True)]</field>
    </record>

</odoo>
