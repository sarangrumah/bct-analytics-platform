<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_ppob_daily_rollup" model="ir.cron">
            <field name="name">PPOB: Daily Rollup (sale.order per mitra)</field>
            <field name="model_id" ref="model_custom_ppob_rollup"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_rollup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=1, minute=0, second=0) + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
