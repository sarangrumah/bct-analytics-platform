<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ppob_provider_topup_log_list" model="ir.ui.view">
        <field name="name">custom.ppob.provider.topup.log.list</field>
        <field name="model">custom.ppob.provider.topup.log</field>
        <field name="arch" type="xml">
            <list string="Provider Topup Log">
                <field name="create_date"/>
                <field name="request_uid"/>
                <field name="provider_id"/>
                <field name="bucket_id"/>
                <field name="gross_amount"/>
                <field name="discount_amount"/>
                <field name="paid_amount"/>
                <field name="dpp_amount"/>
                <field name="ppn_amount"/>
                <field name="timing"/>
                <field name="coretax_method"/>
                <field name="state" widget="badge"
                       decoration-success="state=='posted'"
                       decoration-info="state=='draft'"
                       decoration-muted="state=='cancel'"/>
                <field name="dp_invoice_id"/>
                <field name="pelunasan_invoice_id"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ppob_provider_topup_log_form" model="ir.ui.view">
        <field name="name">custom.ppob.provider.topup.log.form</field>
        <field name="model">custom.ppob.provider.topup.log</field>
        <field name="arch" type="xml">
            <form string="Provider Topup Request">
                <sheet>
                    <h1><field name="request_uid" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="provider_id" readonly="1"/>
                            <field name="bucket_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="gross_amount"/>
                            <field name="discount_amount"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="dpp_amount"/>
                            <field name="ppn_amount"/>
                            <field name="timing" readonly="1"/>
                            <field name="coretax_method" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Linked vendor bills">
                        <field name="dp_invoice_id" readonly="1"/>
                        <field name="pelunasan_invoice_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ppob_provider_topup_log" model="ir.actions.act_window">
        <field name="name">Provider Topup Requests</field>
        <field name="res_model">custom.ppob.provider.topup.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
