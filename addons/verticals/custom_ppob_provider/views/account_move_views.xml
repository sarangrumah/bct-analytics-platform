<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Surface provider DP/Pelunasan link on vendor bills -->
    <record id="view_account_move_form_provider_dp" model="ir.ui.view">
        <field name="name">account.move.form.custom.ppob.provider.dp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Provider Topup (DP/Pelunasan)" name="ppob_provider_dp"
                      invisible="not x_custom_ppob_dp_role">
                    <group>
                        <group>
                            <field name="x_custom_ppob_dp_role" readonly="1"/>
                            <field name="x_custom_ppob_bucket_id" readonly="1"/>
                            <field name="x_custom_ppob_topup_log_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="x_custom_ppob_dp_bill_id" readonly="1"
                                   invisible="x_custom_ppob_dp_role != 'pelunasan'"/>
                            <field name="x_custom_ppob_pelunasan_bill_id" readonly="1"
                                   invisible="x_custom_ppob_dp_role != 'dp_100'"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
