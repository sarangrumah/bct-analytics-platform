<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ppob_provider_sku_map_list" model="ir.ui.view">
        <field name="name">custom.ppob.provider.sku.map.list</field>
        <field name="model">custom.ppob.provider.sku.map</field>
        <field name="arch" type="xml">
            <list string="SKU Map" editable="bottom">
                <field name="provider_id"/>
                <field name="product_id"/>
                <field name="provider_sku"/>
                <field name="buy_price"/>
                <field name="priority"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_ppob_provider_sku_map" model="ir.actions.act_window">
        <field name="name">SKU Map</field>
        <field name="res_model">custom.ppob.provider.sku.map</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
