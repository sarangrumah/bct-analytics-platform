<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ppob_product_list" model="ir.ui.view">
        <field name="name">custom.ppob.product.list</field>
        <field name="model">custom.ppob.product</field>
        <field name="arch" type="xml">
            <list string="PPOB Products">
                <field name="code"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="denom"/>
                <field name="cost_price_default"/>
                <field name="inquiry_required"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ppob_product_form" model="ir.ui.view">
        <field name="name">custom.ppob.product.form</field>
        <field name="model">custom.ppob.product</field>
        <field name="arch" type="xml">
            <form string="PPOB Product">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Telkomsel Pulsa 5.000"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="class_id"/>
                            <field name="inquiry_required"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="denom"/>
                            <field name="cost_price_default"/>
                        </group>
                    </group>
                    <group string="GL Account Overrides (optional)">
                        <field name="revenue_account_id"/>
                        <field name="cogs_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ppob_product_search" model="ir.ui.view">
        <field name="name">custom.ppob.product.search</field>
        <field name="model">custom.ppob.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="class_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="inquiry" string="Inquiry Required" domain="[('inquiry_required','=',True)]"/>
                <group>
                    <filter name="group_class" string="Class" context="{'group_by': 'class_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ppob_product" model="ir.actions.act_window">
        <field name="name">PPOB Products</field>
        <field name="res_model">custom.ppob.product</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
