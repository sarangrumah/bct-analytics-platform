<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ppob_account_mapping_list" model="ir.ui.view">
        <field name="name">custom.ppob.account.mapping.list</field>
        <field name="model">custom.ppob.account.mapping</field>
        <field name="arch" type="xml">
            <list string="PPOB Account Mapping" editable="bottom">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="role"/>
                <field name="account_id"/>
            </list>
        </field>
    </record>

    <record id="action_ppob_account_mapping" model="ir.actions.act_window">
        <field name="name">Account Mapping</field>
        <field name="res_model">custom.ppob.account.mapping</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Role-addressed GL account mapping for the PPOB suite.
            </p>
            <p>
                These rows are seeded on install. Edit an account here to
                re-point a role (e.g. <b>ppn_masukan</b>) to a different GL
                account without touching any PPOB module code.
            </p>
        </field>
    </record>

</odoo>
