<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ppob_transaction_form_oracle" model="ir.ui.view">
        <field name="name">custom.ppob.transaction.form.oracle</field>
        <field name="model">custom.ppob.transaction</field>
        <field name="inherit_id" ref="custom_ppob_sale.view_ppob_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='provider_ref']" position="after">
                <field name="oracle_msg016t_id" readonly="1" invisible="not oracle_msg016t_id"/>
                <field name="inbound_source"/>
            </xpath>
        </field>
    </record>

    <record id="view_ppob_transaction_list_oracle" model="ir.ui.view">
        <field name="name">custom.ppob.transaction.list.oracle</field>
        <field name="model">custom.ppob.transaction</field>
        <field name="inherit_id" ref="custom_ppob_sale.view_ppob_transaction_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="inbound_source" optional="show" widget="badge"
                       decoration-info="inbound_source == 'oracle_legacy'"/>
                <field name="oracle_msg016t_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_ppob_transaction_search_oracle" model="ir.ui.view">
        <field name="name">custom.ppob.transaction.search.oracle</field>
        <field name="model">custom.ppob.transaction</field>
        <field name="inherit_id" ref="custom_ppob_sale.view_ppob_transaction_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_native" string="Native Odoo"
                        domain="[('inbound_source','=','odoo')]"/>
                <filter name="filter_legacy" string="EVShop Legacy"
                        domain="[('inbound_source','=','oracle_legacy')]"/>
                <separator/>
                <filter name="filter_oracle_bridge_provider" string="Oracle Bridge Provider"
                        domain="[('provider_id.bridge_mode','=','oracle_bridge')]"/>
                <group>
                    <filter name="group_inbound" string="Source" context="{'group_by': 'inbound_source'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
