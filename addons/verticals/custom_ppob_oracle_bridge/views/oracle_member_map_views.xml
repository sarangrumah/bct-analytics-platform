<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oracle_member_map_list" model="ir.ui.view">
        <field name="name">custom.ppob.oracle.member.map.list</field>
        <field name="model">custom.ppob.oracle.member.map</field>
        <field name="arch" type="xml">
            <list string="Oracle Member Mappings">
                <field name="partner_id"/>
                <field name="oracle_member_id"/>
                <field name="oracle_member_no"/>
                <field name="oracle_member_group"/>
                <field name="last_known_balance" widget="monetary"/>
                <field name="last_balance_sync"/>
                <field name="active"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_oracle_member_map_form" model="ir.ui.view">
        <field name="name">custom.ppob.oracle.member.map.form</field>
        <field name="model">custom.ppob.oracle.member.map</field>
        <field name="arch" type="xml">
            <form string="Oracle Member Mapping">
                <header>
                    <button name="action_lookup_oracle" type="object"
                            string="Lookup from Oracle" class="btn-secondary"
                            help="Fetch MEMBER_NO, MEMBER_GROUP, DEPOSIT_BALANCE from MSG019T"/>
                    <button name="action_view_partner" type="object"
                            string="View Partner" class="btn-link"/>
                </header>
                <sheet>
                    <group>
                        <group string="Odoo">
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Oracle MSG019T">
                            <field name="oracle_member_id"/>
                            <field name="oracle_member_no" readonly="1"/>
                            <field name="oracle_member_group" readonly="1"/>
                        </group>
                    </group>
                    <group string="Last Sync">
                        <field name="last_known_balance" widget="monetary"/>
                        <field name="last_balance_sync"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_oracle_member_map_search" model="ir.ui.view">
        <field name="name">custom.ppob.oracle.member.map.search</field>
        <field name="model">custom.ppob.oracle.member.map</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="oracle_member_id"/>
                <field name="oracle_member_no"/>
                <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active','=',False)]"/>
                <filter name="filter_never_synced" string="Never Synced"
                        domain="[('last_balance_sync','=',False)]"/>
                <group>
                    <filter name="group_active" string="Status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oracle_member_map" model="ir.actions.act_window">
        <field name="name">Member Mapping</field>
        <field name="res_model">custom.ppob.oracle.member.map</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
