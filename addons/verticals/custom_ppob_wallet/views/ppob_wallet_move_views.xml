<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ppob_wallet_move_list" model="ir.ui.view">
        <field name="name">custom.ppob.wallet.move.list</field>
        <field name="model">custom.ppob.wallet.move</field>
        <field name="arch" type="xml">
            <list string="Wallet Moves" create="false">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="class_id"/>
                <field name="type"/>
                <field name="amount_signed" sum="Sum"/>
                <field name="balance_after"/>
                <field name="ref"/>
                <field name="move_id"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ppob_wallet_move_search" model="ir.ui.view">
        <field name="name">custom.ppob.wallet.move.search</field>
        <field name="model">custom.ppob.wallet.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="wallet_id"/>
                <field name="type"/>
                <field name="ref"/>
                <filter name="filter_topup" string="Topups" domain="[('type','=','topup')]"/>
                <filter name="filter_sale" string="Sales" domain="[('type','=','sale')]"/>
                <filter name="filter_refund" string="Refunds" domain="[('type','=','refund')]"/>
                <separator/>
                <filter name="filter_posted" string="Posted" domain="[('state','=','posted')]"/>
                <group>
                    <filter name="group_partner" string="Mitra" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type'}"/>
                    <filter name="group_date_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ppob_wallet_move_pivot" model="ir.ui.view">
        <field name="name">custom.ppob.wallet.move.pivot</field>
        <field name="model">custom.ppob.wallet.move</field>
        <field name="arch" type="xml">
            <pivot string="Wallet Moves">
                <field name="partner_id" type="row"/>
                <field name="date" interval="month" type="row"/>
                <field name="type" type="col"/>
                <field name="amount_signed" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ppob_wallet_move_graph" model="ir.ui.view">
        <field name="name">custom.ppob.wallet.move.graph</field>
        <field name="model">custom.ppob.wallet.move</field>
        <field name="arch" type="xml">
            <graph string="Wallet Moves" type="bar">
                <field name="date" interval="day"/>
                <field name="type"/>
                <field name="amount_signed" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_ppob_wallet_move" model="ir.actions.act_window">
        <field name="name">Wallet Moves</field>
        <field name="res_model">custom.ppob.wallet.move</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

</odoo>
