<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="res_groups_privilege_retail_sales" model="res.groups.privilege">
            <field name="name">the apparel brand Retail Analytics</field>
            <field name="sequence">150</field>
        </record>

        <!-- Read the dashboard and the analysis view. Store and area managers
             live here: they consume numbers, they do not set the goal. -->
        <record id="group_retail_sales_viewer" model="res.groups">
            <field name="name">the apparel brand Retail Analytics / Viewer</field>
            <field name="privilege_id" ref="res_groups_privilege_retail_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Additionally maintains the targets. Setting the target is what turns
             a report into an assessment, so it is a separate grant. -->
        <record id="group_retail_sales_manager" model="res.groups">
            <field name="name">the apparel brand Retail Analytics / Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_retail_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_retail_sales_viewer'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Targets are per company; a multi-company the apparel brand group must not see
             another entity's goals through the dashboard. -->
        <record id="rule_retail_sales_target_company" model="ir.rule">
            <field name="name">Sales target: own companies only</field>
            <field name="model_id" ref="model_retail_sales_target"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_retail_sales_report_company" model="ir.rule">
            <field name="name">Sales analysis: own companies only</field>
            <field name="model_id" ref="model_retail_sales_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
