<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Extra payment dimensions on the standalone payment form (Payment #4).
      Memo (native ``memo``) and Reference (native ``payment_reference``) are
      surfaced here alongside the Operating Unit, the two account overrides and
      the Note / Remark fields. The overrides change the posted GL; Note / Remark
      are informational and also print on the Payment Voucher.
    -->
    <record id="view_account_payment_form_retail_extra" model="ir.ui.view">
        <field name="name">account.payment.form.retail.extra</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="l10n_ou_analytic_id"
                       domain="['&amp;', ('plan_id.name', '=', 'Operating Unit'), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       options="{'no_create': True}"/>
                <field name="destination_account_id"
                       domain="['&amp;', ('company_ids', 'in', company_id),
                                '|', ('account_type', 'in', ('asset_receivable', 'liability_payable')),
                                     ('l10n_allow_payment_destination', '=', True)]"
                       options="{'no_create': True}"/>
                <field name="l10n_override_outstanding_account_id"
                       options="{'no_create': True}"/>
                <field name="payment_reference"/>
                <field name="l10n_note"/>
                <field name="l10n_remark"/>
            </field>
        </field>
    </record>
</odoo>
