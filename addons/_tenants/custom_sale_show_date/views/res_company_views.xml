<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_tenant_show_date" model="ir.ui.view">
        <field name="name">res.company.form.tenant.show.date</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Show Date" name="tenant_show_date">
                    <group>
                        <field name="x_custom_show_date_enabled"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
