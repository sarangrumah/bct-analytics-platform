<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_tenant_show_date" model="ir.ui.view">
        <field name="name">account.move.form.tenant.show.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="after">
                <field name="x_custom_show_date"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
            </field>
        </field>
    </record>
</odoo>
