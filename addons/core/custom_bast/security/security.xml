<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Own privilege: groups that share one are rendered as a single
             pick-one dropdown on the user form, so sharing it across modules
             makes saving a user silently drop every other module's group. -->
        <record id="res_groups_privilege_bast" model="res.groups.privilege">
            <field name="name">BAST</field>
            <field name="sequence">112</field>
            <field name="category_id" ref="custom_core.module_category_custom_platform"/>
        </record>

        <record id="group_bast_user" model="res.groups">
            <field name="name">Custom BAST / User</field>
            <field name="privilege_id" ref="res_groups_privilege_bast"/>
            <field name="implied_ids" eval="[(4, ref('custom_core.group_custom_user'))]"/>
        </record>
        <record id="group_bast_manager" model="res.groups">
            <field name="name">Custom BAST / Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_bast"/>
            <field name="implied_ids" eval="[(4, ref('group_bast_user'))]"/>
        </record>
    </data>
</odoo>
