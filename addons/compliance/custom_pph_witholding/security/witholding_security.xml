<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Own privilege: groups that share one are rendered as a single
             pick-one dropdown on the user form, so sharing it across modules
             makes saving a user silently drop every other module's group. -->
        <record id="res_groups_privilege_witholding" model="res.groups.privilege">
            <field name="name">PPh Withholding</field>
            <field name="sequence">122</field>
            <field name="category_id" ref="custom_core.module_category_custom_platform"/>
        </record>


        <record id="group_witholding_user" model="res.groups">
            <field name="name">Witholding / User</field>
            <field name="privilege_id" ref="res_groups_privilege_witholding"/>
            <field name="implied_ids" eval="[(4, ref('custom_core.group_custom_user'))]"/>
        </record>

        <record id="group_witholding_manager" model="res.groups">
            <field name="name">Witholding / Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_witholding"/>
            <field name="implied_ids" eval="[(4, ref('group_witholding_user'))]"/>
        </record>

    </data>
</odoo>
