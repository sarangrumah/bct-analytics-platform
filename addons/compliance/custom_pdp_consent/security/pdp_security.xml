<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Own privilege: groups that share one are rendered as a single
             pick-one dropdown on the user form, so sharing it across modules
             makes saving a user silently drop every other module's group. -->
        <record id="res_groups_privilege_pdp_consent" model="res.groups.privilege">
            <field name="name">PDP Consent</field>
            <field name="sequence">132</field>
            <field name="category_id" ref="custom_core.module_category_custom_platform"/>
        </record>

        <record id="group_consent_manager" model="res.groups">
            <field name="name">PDP / Consent Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_pdp_consent"/>
            <field name="implied_ids" eval="[(4, ref('custom_core.group_custom_user'))]"/>
        </record>

        <record id="rule_pdp_consent_portal" model="ir.rule">
            <field name="name">Portal: own consents only</field>
            <field name="model_id" ref="model_pdp_consent"/>
            <field name="domain_force">[('partner_id','=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
