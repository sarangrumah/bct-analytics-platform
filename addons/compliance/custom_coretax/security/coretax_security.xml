<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Own privilege: groups that share one are rendered as a single
             pick-one dropdown on the user form, so sharing it across modules
             makes saving a user silently drop every other module's group. -->
        <record id="res_groups_privilege_coretax" model="res.groups.privilege">
            <field name="name">Coretax</field>
            <field name="sequence">120</field>
            <field name="category_id" ref="custom_core.module_category_custom_platform"/>
        </record>


        <record id="group_user" model="res.groups">
            <field name="name">Coretax / User</field>
            <field name="privilege_id" ref="res_groups_privilege_coretax"/>
            <field name="implied_ids" eval="[(4, ref('custom_core.group_custom_user'))]"/>
            <field name="comment">Can manage Bukti Potong records, generate/import XML, view Coretax config (read-only).</field>
        </record>

        <record id="group_admin" model="res.groups">
            <field name="name">Coretax / Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_coretax"/>
            <field name="implied_ids" eval="[(4, ref('group_user')), (4, ref('custom_core.group_custom_admin'))]"/>
            <field name="comment">Can edit Coretax configuration and upload Sertifikat Elektronik (.p12).</field>
        </record>

    </data>
</odoo>
