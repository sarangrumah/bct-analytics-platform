# https://editorconfig.org
# Mirrors .gitattributes. If these two ever disagree, .gitattributes wins —
# git is what actually writes the working tree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,tf,tfvars}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,makefile,*.mk}]
# Recipe lines MUST begin with a literal tab.
indent_style = tab

[*.sh]
indent_size = 2

[*.sql]
indent_size = 2
